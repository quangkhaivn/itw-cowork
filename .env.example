# TGTH Business Cowork
# Chép tệp này thành .env rồi điền giá trị thật. KHÔNG bao giờ commit tệp .env.

# --- PostgreSQL ---
# Vai chủ sở hữu: CHỈ dùng để chạy migration và seed.
# Không dùng cho ứng dụng, vì chủ sở hữu bảng được PostgreSQL cho bỏ qua RLS.
POSTGRES_USER=cowork_owner
POSTGRES_PASSWORD=doi_mat_khau_nay
POSTGRES_DB=cowork

# Mật khẩu của vai ứng dụng cowork_app. Script trien-khai.sh dùng biến này để
# tạo vai, nên nó PHẢI khớp với mật khẩu nằm trong DATABASE_URL bên dưới.
APP_DB_PASSWORD=doi_mat_khau_app

# Ứng dụng kết nối bằng cowork_app — bị RLS ràng buộc.
DATABASE_URL=postgresql://cowork_app:doi_mat_khau_app@db:5432/cowork?schema=public
DATABASE_URL_OWNER=postgresql://cowork_owner:doi_mat_khau_nay@db:5432/cowork?schema=public

# --- Redis ---
REDIS_PASSWORD=doi_mat_khau_redis
REDIS_URL=redis://:doi_mat_khau_redis@redis:6379

# --- Ứng dụng ---
# Chuỗi ký phiên đăng nhập, tối thiểu 32 ký tự. Sinh bằng: openssl rand -base64 48
AUTH_SECRET=sinh_chuoi_ngau_nhien_that_dai_vao_day
APP_URL=https://thegioitinhoc.io.vn

# --- Tài khoản quản trị đầu tiên (chỉ dùng lần seed đầu) ---
# Seed KHÔNG ghi đè mật khẩu của tài khoản đã tồn tại.
SEED_ADMIN_EMAIL=admin@thegioitinhoc.vn
# Tối thiểu 10 ký tự, có chữ và số. Hệ thống bắt đổi ở lần đăng nhập đầu.
SEED_ADMIN_PASSWORD=doi_mat_khau_nay_2026

# --- Trợ lý AI (Phase 9) ---
# Chưa đặt khóa thì màn hình Trợ lý báo rõ là chưa dùng được; hệ thống KHÔNG trả lời tạm.
# Khóa chỉ nằm ở biến môi trường, không bao giờ lưu trong cơ sở dữ liệu.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
