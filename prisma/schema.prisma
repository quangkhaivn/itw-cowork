// Cowork Business OS — ITW
// Phase 1: Foundation (multi-tenant, người dùng, phân quyền, sự kiện, kiểm toán)
//
// Quy ước:
// - Tên bảng và tên cột theo đúng mục 20 đặc tả: tiếng Anh, snake_case.
// - Mọi bảng nghiệp vụ mang đủ: id, tenant_id, created_at, updated_at, created_by, updated_by, status.
// - Cách ly tenant được chốt ở hai lớp: Prisma (mục src/lib/db.ts) và PostgreSQL RLS (migration 0002).
//   Không dựa vào kỷ luật lập trình viên.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: url của datasource khai ở prisma.config.ts, không khai ở đây.
datasource db {
  provider = "postgresql"
}

/// Doanh nghiệp thuê bao. Bảng gốc của toàn hệ thống — không mang tenant_id.
model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50) /// mã ngắn, ví dụ "itw"
  name      String   @db.VarChar(255)
  taxCode   String?  @map("tax_code") @db.VarChar(50)
  status    String   @default("hoat-dong") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  settings             TenantSetting[]
  users                User[]
  departments          Department[]
  roles                Role[]
  staffProfiles        StaffProfile[]
  userRoles            UserRole[]
  events               BusinessEvent[]
  auditLogs            AuditLog[]
  masterData           MasterDataItem[]
  // Phase 2 — CRM
  sequences            DocumentSequence[]
  customers            Customer[]
  contacts             Contact[]
  leads                Lead[]
  interactions         Interaction[]
  opportunities        Opportunity[]
  tasks                Task[]
  taskChecklistItems   TaskChecklistItem[]
  // Phase 3 — Sản phẩm và bảng giá
  productCategories    ProductCategory[]
  brands               Brand[]
  suppliers            Supplier[]
  products             Product[]
  supplierPrices       SupplierProductPrice[]
  priceHistory         PriceHistory[]
  importJobs           ImportJob[]
  // Phase 4 — Báo giá
  quotations           Quotation[]
  quotationVersions    QuotationVersion[]
  quotationItems       QuotationItem[]
  quotationApprovals   QuotationApproval[]
  // Phase 5 — Đơn hàng và kho
  warehouses           Warehouse[]
  salesOrders          SalesOrder[]
  salesOrderItems      SalesOrderItem[]
  inventoryBalances    InventoryBalance[]
  inventoryTxns        InventoryTransaction[]
  deliveries           Delivery[]
  deliveryItems        DeliveryItem[]
  serialNumbers        SerialNumber[]
  // Phase 6 — Dự án, bảo hành, phiếu hỗ trợ
  warranties           Warranty[]
  projects             Project[]
  projectMilestones    ProjectMilestone[]
  supportTickets       SupportTicket[]
  ticketEvents         SupportTicketEvent[]
  // Phase 7 — Tài chính
  invoices             Invoice[]
  invoiceItems         InvoiceItem[]
  payments             Payment[]
  paymentAllocations   PaymentAllocation[]
  // Phase 8 — Tự động hóa
  notifications        Notification[]
  automationRules      AutomationRule[]
  jobRuns              JobRun[]
  dailyActionItems     DailyActionItem[]
  maintenanceOrders    MaintenanceContract[]
  renewals             Renewal[]
  // Phase 9 — Trợ lý AI
  aiConversations      AiConversation[]
  aiMessages           AiMessage[]
  aiToolCalls          AiToolCall[]
  aiActions            AiAction[]
  // Mua hàng (phần để lại từ Phase 5)
  purchaseRequests     PurchaseRequest[]
  purchaseReqItems     PurchaseRequestItem[]
  purchaseOrders       PurchaseOrder[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceipts        GoodsReceipt[]
  goodsReceiptItems    GoodsReceiptItem[]
  // Công nợ phải trả
  supplierBills        SupplierBill[]
  supplierBillItems    SupplierBillItem[]
  supplierPayments     SupplierPayment[]
  supplierPayAllocs    SupplierPaymentAllocation[]
  // Trả hàng và đổi máy
  salesReturns         SalesReturn[]
  salesReturnItems     SalesReturnItem[]
  salesReturnAllocs    SalesReturnAllocation[]
  purchaseReturns      PurchaseReturn[]
  purchaseReturnItems  PurchaseReturnItem[]
  purchaseReturnAllocs PurchaseReturnAllocation[]
  // Chuyển kho nội bộ
  stockTransfers       StockTransfer[]
  stockTransferItems   StockTransferItem[]
  // Tệp đính kèm
  attachments          Attachment[]
  // Khách hàng nâng cao (0.16.0)
  journeyStages        CustomerJourneyStage[]
  journeyHistory       CustomerJourneyHistory[]
  customerGroups       CustomerGroup[]
  customerGroupMembers CustomerGroupMember[]
  savedViews           SavedView[]
  listPreferences      UserListPreference[]
  // Marketing và thu lead
  marketingCampaigns   MarketingCampaign[]
  marketingCosts       MarketingCost[]
  leadAssignees        MarketingLeadAssignee[]
  marketingForms       MarketingForm[]
  webhookSources       MarketingWebhookSource[]
  leadCaptures         LeadCapture[]
  marketingSegments    MarketingSegment[]
  landingPages         LandingPage[]
  // Email marketing + xác thực 2 lớp (0.16.0)
  emailSettings        EmailSetting[]
  emailTemplates       EmailTemplate[]
  emailCampaigns       EmailCampaign[]
  emailRecipients      EmailRecipient[]
  emailEvents          EmailEvent[]
  emailSuppressions    EmailSuppression[]
  emailConsents        EmailConsent[]
  emailSnsMessages     EmailSnsMessage[]
  emailTransactionals  EmailTransactional[]
  recoveryCodes        UserRecoveryCode[]

  @@map("tenants")
}

/// Cấu hình riêng của từng tenant, dạng khóa–giá trị để không phải đổi schema khi thêm tùy chọn.
model TenantSetting {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String   @db.VarChar(100)
  value     Json
  status    String   @default("hoat-dong") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("tenant_settings")
}

/// Phòng ban. Cho phép lồng nhau qua parent_id.
model Department {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   @db.VarChar(50)
  name      String   @db.VarChar(255)
  parentId  String?  @map("parent_id") @db.Uuid
  status    String   @default("hoat-dong") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Department?    @relation("PhongBanCha", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[]   @relation("PhongBanCha")
  staff    StaffProfile[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("departments")
}

/// Tài khoản đăng nhập.
model User {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  email              String    @db.VarChar(255)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  fullName           String    @map("full_name") @db.VarChar(255)
  phone              String?   @db.VarChar(30)
  isSystem           Boolean   @default(false) @map("is_system") /// true = tác nhân máy (ví dụ trợ lý ITA)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(6)
  /// Bắt đổi mật khẩu ở lần đăng nhập kế tiếp (tài khoản mới, hoặc quản trị vừa đặt lại).
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz(6)
  /// Số lần sai mật khẩu liên tiếp. Về 0 khi đăng nhập đúng.
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  /// Khóa tạm tới thời điểm này sau quá nhiều lần sai.
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(6)
  /// Xác thực 2 lớp (TOTP RFC 6238). Khóa bí mật **mã hóa** AES-256-GCM bằng APP_ENC_KEY, không lưu dạng thuần.
  totpSecretEnc      String?   @map("totp_secret_enc") @db.Text
  /// Khóa đang chờ xác nhận lúc người dùng bật 2 lớp (chưa có hiệu lực cho tới khi nhập đúng mã).
  totpPendingEnc     String?   @map("totp_pending_enc") @db.Text
  totpEnabledAt      DateTime? @map("totp_enabled_at") @db.Timestamptz(6)
  /// Bước thời gian (30 giây) của mã đã dùng gần nhất — chặn dùng lại cùng một mã.
  totpLastStep       BigInt?   @map("totp_last_step")
  /// Mốc đổi thiết lập bảo mật (bật/tắt/đặt lại 2 lớp). Phiên ký trước mốc này hết hiệu lực, như đổi mật khẩu.
  securityChangedAt  DateTime? @map("security_changed_at") @db.Timestamptz(6)
  status             String    @default("hoat-dong") @db.VarChar(30)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          String?   @map("created_by") @db.Uuid
  updatedBy          String?   @map("updated_by") @db.Uuid

  tenant               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffProfile         StaffProfile?            @relation("HoSoCuaNguoiDung")
  userRoles            UserRole[]
  /// Những người nhận người này làm quản lý trực tiếp.
  reports              StaffProfile[]           @relation("QuanLyTrucTiep")
  // Phase 2 — người phụ trách
  ownedCustomers       Customer[]               @relation("KhachPhuTrach")
  ownedLeads           Lead[]                   @relation("LeadPhuTrach")
  ownedInteractions    Interaction[]            @relation("TuongTacCua")
  ownedOpportunities   Opportunity[]            @relation("CoHoiPhuTrach")
  ownedTasks           Task[]                   @relation("ViecPhuTrach")
  taskResults          Task[]                   @relation("ViecGhiKetQua")
  assignedTasks        Task[]                   @relation("ViecNguoiGiao")
  checklistTicks       TaskChecklistItem[]      @relation("MucKiemTraNguoiTich")
  ownedQuotations      Quotation[]              @relation("BaoGiaPhuTrach")
  ownedSalesOrders     SalesOrder[]             @relation("DonHangPhuTrach")
  managedProjects      Project[]                @relation("DuAnPhuTrach")
  ownedTickets         SupportTicket[]          @relation("PhieuHoTroTiepNhan")
  assignedTickets      SupportTicket[]          @relation("PhieuHoTroXuLy")
  ownedInvoices        Invoice[]                @relation("HoaDonPhuTrach")
  // Phase 8
  notifications        Notification[]           @relation("ThongBaoCuaNguoiDung")
  dailyActionItems     DailyActionItem[]        @relation("ViecHomNayCuaNguoiDung")
  ownedMaintenance     MaintenanceContract[]    @relation("BaoTriPhuTrach")
  ownedRenewals        Renewal[]                @relation("GiaHanPhuTrach")
  // Phase 9
  aiConversations      AiConversation[]         @relation("HoiThoaiCuaNguoiDung")
  // Mua hàng
  purchaseRequests     PurchaseRequest[]        @relation("DeNghiMuaCua")
  ownedPurchaseOrders  PurchaseOrder[]          @relation("DonMuaPhuTrach")
  ownedSupplierBills   SupplierBill[]           @relation("HoaDonMuaPhuTrach")
  ownedSalesReturns    SalesReturn[]            @relation("TraHangBanPhuTrach")
  ownedPurchaseReturns PurchaseReturn[]         @relation("TraHangMuaPhuTrach")
  ownedStockTransfers  StockTransfer[]          @relation("ChuyenKhoPhuTrach")
  uploadedAttachments  Attachment[]             @relation("TepDinhKemNguoiTai")
  savedViews           SavedView[]              @relation("BoLocCua")
  listPreferences      UserListPreference[]     @relation("TuyChonDanhSachCua")
  // Marketing
  ownedCampaigns       MarketingCampaign[]      @relation("ChienDichPhuTrach")
  leadAssignee         MarketingLeadAssignee[]  @relation("NhanLeadVongTron")
  ownedForms           MarketingForm[]          @relation("FormPhuTrach")
  ownedWebhookSources  MarketingWebhookSource[] @relation("NguonWebhookPhuTrach")
  ownedSegments        MarketingSegment[]       @relation("PhanKhucPhuTrach")
  ownedLandingPages    LandingPage[]            @relation("LandingPhuTrach")
  // Xác thực 2 lớp
  recoveryCodes        UserRecoveryCode[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

/// Hồ sơ nhân sự gắn với tài khoản. Tách khỏi users để users chỉ lo việc đăng nhập.
model StaffProfile {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  departmentId String?   @map("department_id") @db.Uuid
  /// Quản lý trực tiếp — dùng cho phạm vi dữ liệu "team".
  managerId    String?   @map("manager_id") @db.Uuid
  employeeCode String?   @map("employee_code") @db.VarChar(50)
  jobTitle     String?   @map("job_title") @db.VarChar(255)
  hiredAt      DateTime? @map("hired_at") @db.Date
  status       String    @default("hoat-dong") @db.VarChar(30)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User        @relation("HoSoCuaNguoiDung", fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager    User?       @relation("QuanLyTrucTiep", fields: [managerId], references: [id], onDelete: SetNull)

  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@index([tenantId, departmentId])
  @@index([tenantId, managerId])
  @@map("staff_profiles")
}

/// Vai trò. Theo tenant để mỗi doanh nghiệp tự định nghĩa được bộ vai trò của mình.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  isBuiltIn   Boolean  @default(false) @map("is_built_in") /// vai trò dựng sẵn, không cho xóa
  status      String   @default("hoat-dong") @db.VarChar(30)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("roles")
}

/// Danh mục quyền của hệ thống. Toàn cục, không theo tenant: đây là danh sách
/// khả năng mà phần mềm hỗ trợ, giống nhau ở mọi doanh nghiệp.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100) /// ví dụ "quotation.approve"
  module      String   @db.VarChar(50)
  action      String   @db.VarChar(50)
  description String?  @db.Text
  status      String   @default("hoat-dong") @db.VarChar(30)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

/// Nối vai trò với quyền. Mục 20 không liệt kê bảng này nhưng RBAC không chạy được nếu thiếu.
model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  /// Phạm vi dữ liệu: own | team | department | all. Ràng buộc CHECK ở migration.
  dataScope    String   @default("all") @map("data_scope") @db.VarChar(20)
  status       String   @default("hoat-dong") @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([tenantId])
  @@map("role_permissions")
}

/// Nối người dùng với vai trò.
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  status    String   @default("hoat-dong") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([tenantId])
  @@map("user_roles")
}

/// Sự kiện vận hành — hệ thần kinh của hệ thống (mục 16 đặc tả).
/// Chỉ ghi thêm. Không sửa, không xóa.
model BusinessEvent {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  eventType  String   @map("event_type") @db.VarChar(100)
  actorType  String   @map("actor_type") @db.VarChar(30) /// user | system | ai
  actorId    String?  @map("actor_id") @db.Uuid
  objectType String   @map("object_type") @db.VarChar(50)
  objectId   String?  @map("object_id") @db.Uuid
  payload    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, eventType])
  @@index([tenantId, objectType, objectId])
  @@index([tenantId, createdAt])
  @@map("business_events")
}

/// Nhật ký kiểm toán — truy vết ai đã đổi cái gì (mục 27 đặc tả).
/// Chỉ ghi thêm. Không sửa, không xóa.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorEmail String?  @map("actor_email") @db.VarChar(255) /// chụp lại tại thời điểm ghi, phòng khi tài khoản bị xóa
  action     String   @db.VarChar(50) /// tao | sua | xoa | dang-nhap | dang-xuat | tu-choi-quyen
  objectType String   @map("object_type") @db.VarChar(50)
  objectId   String?  @map("object_id") @db.Uuid
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, objectType, objectId])
  @@index([tenantId, actorId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

/// Dữ liệu gốc dùng chung: ngành nghề, loại khách, nguồn lead, lý do thua, đơn vị tính,
/// điều khoản thanh toán/giao hàng... Một bảng cho các danh mục ngắn, ít cột, để không
/// phải mở bảng mới cho mỗi danh sách chọn. Danh mục có nghiệp vụ riêng (nhóm sản phẩm,
/// thương hiệu, kho) có bảng riêng ở phase của nó — không nhồi vào đây.
model MasterDataItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  type        String   @db.VarChar(50) /// khóa loại, xem src/modules/du-lieu-goc/loai.ts
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  status      String   @default("hoat-dong") @db.VarChar(30)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, code])
  @@index([tenantId, type, status])
  @@map("master_data_items")
}

// ===========================================================================
// Phase 2 — CRM (20/09/2026)
//
// Chuỗi: Lead → (chuyển đổi) → Customer + Contact → Opportunity → (Phase 4) Quotation.
// Luật nghiệp vụ: BUSINESS_RULES.md mục 3. Ràng buộc CHECK viết tay trong migration.
// ===========================================================================

/// Bộ đếm số chứng từ (KH-000001, CH-2026-0001…). Cấp số bằng
/// INSERT … ON CONFLICT DO UPDATE … RETURNING — nguyên tử, không trùng khi tạo đồng thời.
model DocumentSequence {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  docType    String   @map("doc_type") @db.VarChar(30) /// customer | lead | opportunity | quotation…
  period     String   @default("") @db.VarChar(10) /// "" = không đánh lại; "2026" = đánh lại theo năm
  lastNumber Int      @default(0) @map("last_number")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, docType, period])
  @@map("document_sequences")
}

/// Khách hàng (doanh nghiệp hoặc cá nhân). Một khách một mã.
model Customer {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  code                  String    @db.VarChar(30)
  name                  String    @db.VarChar(255)
  /// Tên đã bỏ dấu, bỏ "công ty/TNHH/cổ phần…" — dùng dò trùng gần giống.
  nameNormalized        String    @map("name_normalized") @db.VarChar(255)
  taxCode               String?   @map("tax_code") @db.VarChar(30)
  taxCodeNormalized     String?   @map("tax_code_normalized") @db.VarChar(20)
  customerType          String?   @map("customer_type") @db.VarChar(50) /// mã dữ liệu gốc loai_khach_hang
  segment               String?   @db.VarChar(50) /// mã dữ liệu gốc phan_khuc_khach_hang
  industry              String?   @db.VarChar(50) /// mã dữ liệu gốc nganh_nghe
  source                String?   @db.VarChar(50) /// mã dữ liệu gốc nguon_lead
  address               String?   @db.Text
  province              String?   @db.VarChar(100)
  website               String?   @db.VarChar(255)
  /// Marketing: chiến dịch đưa khách này tới (chạm đầu tiên — MK-10). Chỉ ghi khi đang trống.
  campaignId            String?   @map("campaign_id") @db.Uuid
  phone                 String?   @db.VarChar(30)
  phoneNormalized       String?   @map("phone_normalized") @db.VarChar(20)
  email                 String?   @db.VarChar(255)
  emailNormalized       String?   @map("email_normalized") @db.VarChar(255)
  ownerId               String    @map("owner_id") @db.Uuid
  note                  String?   @db.Text
  /// tiem-nang | dang-giao-dich | ngung-giao-dich | da-gop (CHECK ở migration)
  status                String    @default("tiem-nang") @db.VarChar(30)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy             String?   @map("created_by") @db.Uuid
  updatedBy             String?   @map("updated_by") @db.Uuid
  /// 0.16.0 — trạng thái hành trình (danh mục theo doanh nghiệp). KHÁC `status` (đang/ngừng giao dịch).
  journeyStageId        String?   @map("journey_stage_id") @db.Uuid
  journeyStageChangedAt DateTime? @map("journey_stage_changed_at") @db.Timestamptz(6)
  /// 0.16.0 — khách đã gộp vào khách khác: không xóa, trỏ sang khách giữ lại (KHN-12).
  mergedIntoId          String?   @map("merged_into_id") @db.Uuid
  mergedAt              DateTime? @map("merged_at") @db.Timestamptz(6)
  mergedBy              String?   @map("merged_by") @db.Uuid
  /// 0.16.0 — điểm khách tiềm năng 0–100, tính lại khi có sự kiện liên quan (KHN-08).
  leadScore             Int?      @map("lead_score") @db.SmallInt
  leadScoreAt           DateTime? @map("lead_score_at") @db.Timestamptz(6)

  tenant               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner                User                     @relation("KhachPhuTrach", fields: [ownerId], references: [id], onDelete: Restrict)
  campaign             MarketingCampaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contacts             Contact[]
  interactions         Interaction[]
  opportunities        Opportunity[]
  tasks                Task[]
  convertedLeads       Lead[]                   @relation("LeadThanhKhach")
  /// Marketing: lead mới khớp khách này lúc nhận (MK-07).
  matchedLeads         Lead[]                   @relation("LeadTrungKhach")
  quotations           Quotation[]
  salesOrders          SalesOrder[]
  warranties           Warranty[]
  projects             Project[]
  tickets              SupportTicket[]
  invoices             Invoice[]
  payments             Payment[]
  maintenanceContracts MaintenanceContract[]
  renewals             Renewal[]
  salesReturns         SalesReturn[]
  journeyStage         CustomerJourneyStage?    @relation(fields: [journeyStageId], references: [id], onDelete: Restrict)
  mergedInto           Customer?                @relation("KhachDaGop", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom           Customer[]               @relation("KhachDaGop")
  journeyHistory       CustomerJourneyHistory[]
  groupMembers         CustomerGroupMember[]

  @@unique([tenantId, code])
  @@unique([tenantId, taxCodeNormalized])
  @@index([tenantId, journeyStageId])
  @@index([tenantId, leadScore])
  @@index([tenantId, ownerId])
  @@index([tenantId, phoneNormalized])
  @@index([tenantId, emailNormalized])
  @@index([tenantId, status])
  @@index([tenantId, campaignId])
  @@index([nameNormalized(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_name_normalized_trgm_idx")
  @@map("customers")
}

/// Người liên hệ của khách hàng. Quyền và phạm vi đi theo khách.
model Contact {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  customerId             String    @map("customer_id") @db.Uuid
  fullName               String    @map("full_name") @db.VarChar(255)
  title                  String?   @db.VarChar(255) /// chức danh
  department             String?   @db.VarChar(255)
  phone                  String?   @db.VarChar(30)
  phoneNormalized        String?   @map("phone_normalized") @db.VarChar(20)
  email                  String?   @db.VarChar(255)
  emailNormalized        String?   @map("email_normalized") @db.VarChar(255)
  zalo                   String?   @db.VarChar(50)
  /// 0.16.0 — ngày sinh, dùng cho nhắc sinh nhật (KHN-15). Không bắt buộc.
  birthDate              DateTime? @map("birth_date") @db.Date
  isPrimary              Boolean   @default(false) @map("is_primary")
  note                   String?   @db.Text
  /// Đồng ý nhận tin marketing (MK-13) — chỉ đặt khi chính người đó đồng ý.
  marketingOptIn         Boolean   @default(false) @map("marketing_opt_in")
  marketingOptInAt       DateTime? @map("marketing_opt_in_at") @db.Timestamptz(6)
  /// Từ chối nhận tin: luôn thắng đồng ý (CHECK không cho hai cờ cùng bật). Email marketing (EM) dùng chung cột này.
  marketingOptOutAt      DateTime? @map("marketing_opt_out_at") @db.Timestamptz(6)
  /// Đồng ý / từ chối ghi nhận ở đâu: "form:<slug>", "webhook:<mã>", "nhap-tay", "huy-dang-ky"…
  marketingConsentSource String?   @map("marketing_consent_source") @db.VarChar(100)
  status                 String    @default("hoat-dong") @db.VarChar(30)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy              String?   @map("created_by") @db.Uuid
  updatedBy              String?   @map("updated_by") @db.Uuid

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  interactions    Interaction[]
  opportunities   Opportunity[]
  quotations      Quotation[]
  salesOrders     SalesOrder[]
  tickets         SupportTicket[]
  emailRecipients EmailRecipient[]

  @@index([tenantId, customerId])
  @@index([tenantId, phoneNormalized])
  @@index([tenantId, emailNormalized])
  @@map("contacts")
}

/// Lead — người/doanh nghiệp có nhu cầu, chưa thành khách. Không bao giờ xóa.
model Lead {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  code                   String    @db.VarChar(30)
  fullName               String    @map("full_name") @db.VarChar(255)
  companyName            String?   @map("company_name") @db.VarChar(255)
  title                  String?   @db.VarChar(255)
  phone                  String?   @db.VarChar(30)
  phoneNormalized        String?   @map("phone_normalized") @db.VarChar(20)
  email                  String?   @db.VarChar(255)
  emailNormalized        String?   @map("email_normalized") @db.VarChar(255)
  taxCode                String?   @map("tax_code") @db.VarChar(30)
  taxCodeNormalized      String?   @map("tax_code_normalized") @db.VarChar(20)
  source                 String?   @db.VarChar(50) /// mã dữ liệu gốc nguon_lead
  need                   String?   @db.Text /// nhu cầu khách nói
  estimatedValue         Decimal?  @map("estimated_value") @db.Decimal(18, 2)
  /// NEW_LEAD | CONTACTED | QUALIFIED | DISQUALIFIED | CONVERTED
  stage                  String    @default("NEW_LEAD") @db.VarChar(20)
  ownerId                String    @map("owner_id") @db.Uuid
  disqualifiedReason     String?   @map("disqualified_reason") @db.Text
  convertedCustomerId    String?   @map("converted_customer_id") @db.Uuid
  convertedOpportunityId String?   @map("converted_opportunity_id") @db.Uuid
  convertedAt            DateTime? @map("converted_at") @db.Timestamptz(6)
  /// Dữ liệu gốc từ website / Zalo / form — giữ nguyên để đối chiếu.
  rawPayload             Json?     @map("raw_payload")
  note                   String?   @db.Text
  // --- Marketing (0.16.0) ---
  /// Chiến dịch đưa lead tới (MK-10).
  campaignId             String?   @map("campaign_id") @db.Uuid
  utmSource              String?   @map("utm_source") @db.VarChar(120)
  utmMedium              String?   @map("utm_medium") @db.VarChar(120)
  utmCampaign            String?   @map("utm_campaign") @db.VarChar(120)
  utmContent             String?   @map("utm_content") @db.VarChar(120)
  utmTerm                String?   @map("utm_term") @db.VarChar(120)
  /// Kênh nhận: form | landing | webhook | nhap-tay. Null = lead do sale tạo trong CRM.
  captureChannel         String?   @map("capture_channel") @db.VarChar(20)
  /// Lúc nhận, SĐT/email/MST đã khớp khách hàng này (MK-07) — cảnh báo cho sale.
  matchedCustomerId      String?   @map("matched_customer_id") @db.Uuid
  marketingOptIn         Boolean   @default(false) @map("marketing_opt_in")
  marketingOptInAt       DateTime? @map("marketing_opt_in_at") @db.Timestamptz(6)
  marketingOptOutAt      DateTime? @map("marketing_opt_out_at") @db.Timestamptz(6)
  marketingConsentSource String?   @map("marketing_consent_source") @db.VarChar(100)
  status                 String    @default("hoat-dong") @db.VarChar(30)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy              String?   @map("created_by") @db.Uuid
  updatedBy              String?   @map("updated_by") @db.Uuid

  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner                User               @relation("LeadPhuTrach", fields: [ownerId], references: [id], onDelete: Restrict)
  convertedCustomer    Customer?          @relation("LeadThanhKhach", fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  convertedOpportunity Opportunity?       @relation("LeadThanhCoHoi", fields: [convertedOpportunityId], references: [id], onDelete: SetNull)
  interactions         Interaction[]
  tasks                Task[]
  campaign             MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  matchedCustomer      Customer?          @relation("LeadTrungKhach", fields: [matchedCustomerId], references: [id], onDelete: SetNull)
  captures             LeadCapture[]
  emailRecipients      EmailRecipient[]

  @@unique([tenantId, code])
  @@index([tenantId, ownerId])
  @@index([tenantId, stage])
  @@index([tenantId, phoneNormalized])
  @@index([tenantId, emailNormalized])
  @@index([tenantId, taxCodeNormalized])
  @@index([tenantId, campaignId])
  @@map("leads")
}

/// Tương tác đã xảy ra: gọi, email, Zalo, gặp, thăm, ghi chú ("Interaction" trong prompt).
model Interaction {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  /// call | email | zalo | meeting | visit | note
  type          String   @db.VarChar(20)
  customerId    String?  @map("customer_id") @db.Uuid
  contactId     String?  @map("contact_id") @db.Uuid
  leadId        String?  @map("lead_id") @db.Uuid
  opportunityId String?  @map("opportunity_id") @db.Uuid
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  subject       String   @db.VarChar(255)
  content       String?  @db.Text
  outcome       String?  @db.VarChar(255)
  ownerId       String   @map("owner_id") @db.Uuid
  status        String   @default("hoat-dong") @db.VarChar(30)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy     String?  @map("created_by") @db.Uuid
  updatedBy     String?  @map("updated_by") @db.Uuid

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner       User         @relation("TuongTacCua", fields: [ownerId], references: [id], onDelete: Restrict)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Restrict)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([tenantId, customerId, occurredAt(sort: Desc)])
  @@index([tenantId, leadId, occurredAt(sort: Desc)])
  @@index([tenantId, opportunityId, occurredAt(sort: Desc)])
  @@index([tenantId, ownerId, occurredAt(sort: Desc)])
  @@map("interactions")
}

/// Cơ hội bán hàng. Luật Owner + Next Action + Next Action Date chốt bằng CHECK.
model Opportunity {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  code              String    @db.VarChar(30)
  customerId        String    @map("customer_id") @db.Uuid
  contactId         String?   @map("contact_id") @db.Uuid
  title             String    @db.VarChar(255)
  description       String?   @db.Text
  estimatedValue    Decimal   @default(0) @map("estimated_value") @db.Decimal(18, 2)
  probability       Int       @default(10)
  expectedCloseDate DateTime? @map("expected_close_date") @db.Date
  ownerId           String    @map("owner_id") @db.Uuid
  source            String?   @db.VarChar(50) /// mã dữ liệu gốc nguon_lead
  /// OPPORTUNITY | QUOTATION | NEGOTIATION | WON | LOST
  stage             String    @default("OPPORTUNITY") @db.VarChar(20)
  nextAction        String?   @map("next_action") @db.VarChar(255)
  nextActionDate    DateTime? @map("next_action_date") @db.Date
  lostReason        String?   @map("lost_reason") @db.VarChar(50) /// mã dữ liệu gốc ly_do_thua
  lostNote          String?   @map("lost_note") @db.Text
  competitor        String?   @db.VarChar(255)
  /// Marketing: chiến dịch đưa cơ hội tới (chép từ lead lúc chuyển đổi — MK-10).
  campaignId        String?   @map("campaign_id") @db.Uuid
  closedAt          DateTime? @map("closed_at") @db.Timestamptz(6)
  status            String    @default("hoat-dong") @db.VarChar(30)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy         String?   @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contact      Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner        User               @relation("CoHoiPhuTrach", fields: [ownerId], references: [id], onDelete: Restrict)
  interactions Interaction[]
  tasks        Task[]
  fromLeads    Lead[]             @relation("LeadThanhCoHoi")
  campaign     MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  quotations   Quotation[]
  salesOrders  SalesOrder[]
  renewals     Renewal[]

  @@unique([tenantId, code])
  @@index([tenantId, ownerId, stage])
  @@index([tenantId, customerId])
  @@index([tenantId, stage, nextActionDate])
  @@index([tenantId, campaignId])
  @@map("opportunities")
}

/// Công việc có hạn ("Activity" trong prompt; Task mục P1).
model Task {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  title         String    @db.VarChar(255)
  description   String?   @db.Text
  ownerId       String    @map("owner_id") @db.Uuid
  /// thap | trung-binh | cao | khan
  priority      String    @default("trung-binh") @db.VarChar(20)
  dueAt         DateTime? @map("due_at") @db.Timestamptz(6)
  /// mo | dang-lam | xong | huy
  status        String    @default("mo") @db.VarChar(20)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)
  customerId    String?   @map("customer_id") @db.Uuid
  leadId        String?   @map("lead_id") @db.Uuid
  opportunityId String?   @map("opportunity_id") @db.Uuid
  /// Việc thuộc một dự án triển khai (Phase 6).
  projectId     String?   @map("project_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid
  /// 0.17.0 — kết quả công việc (CV-04). Bắt buộc khi đánh dấu xong (CV-05, kiểm ở service).
  result        String?   @db.Text
  /// dat | mot-phan | khong-dat | can-theo-doi (CHECK ở migration)
  outcome       String?   @db.VarChar(20)
  resultAt      DateTime? @map("result_at") @db.Timestamptz(6)
  resultBy      String?   @map("result_by") @db.Uuid
  /// 0.17.0 — ai giao, lúc nào giao cho người đang phụ trách (CV-08).
  assignedBy    String?   @map("assigned_by") @db.Uuid
  assignedAt    DateTime? @map("assigned_at") @db.Timestamptz(6)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner       User                @relation("ViecPhuTrach", fields: [ownerId], references: [id], onDelete: Restrict)
  resultUser  User?               @relation("ViecGhiKetQua", fields: [resultBy], references: [id], onDelete: SetNull)
  assigner    User?               @relation("ViecNguoiGiao", fields: [assignedBy], references: [id], onDelete: SetNull)
  checklist   TaskChecklistItem[]
  customer    Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead        Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunity Opportunity?        @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  project     Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([tenantId, ownerId, status, dueAt])
  @@index([tenantId, customerId])
  @@index([tenantId, opportunityId])
  @@index([tenantId, projectId])
  @@index([tenantId, leadId])
  @@map("tasks")
}

/// 0.17.0 — danh sách kiểm tra của công việc (CV-07). Mục bắt buộc chưa tích thì không xong được.
/// Gỡ mục là xóa mềm (`removed_at`), không xóa cứng.
model TaskChecklistItem {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  label     String    @db.VarChar(300)
  required  Boolean   @default(true)
  position  Int       @default(0)
  doneAt    DateTime? @map("done_at") @db.Timestamptz(6)
  doneBy    String?   @map("done_by") @db.Uuid
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)
  removedBy String?   @map("removed_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  doneUser User?  @relation("MucKiemTraNguoiTich", fields: [doneBy], references: [id], onDelete: SetNull)

  @@index([tenantId, taskId])
  @@map("task_checklist_items")
}

// ===========================================================================
// Phase 3 — Sản phẩm và bảng giá (20/09/2026)
//
// Mục 8–9 prompt 20/09: Product, Category, Brand, Supplier, SupplierProductPrice,
// PriceHistory. Một sản phẩm có thể mua từ nhiều nhà cung cấp; lịch sử giá chỉ ghi thêm.
// Luật nghiệp vụ: BUSINESS_RULES.md mục 5.
// ===========================================================================

/// Nhóm sản phẩm, lồng nhau qua parent_id (Laptop → Laptop văn phòng…).
model ProductCategory {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  code                  String   @db.VarChar(50)
  name                  String   @db.VarChar(255)
  parentId              String?  @map("parent_id") @db.Uuid
  /// Nhóm này bắt buộc quản lý số sê-ri (laptop, PC, server, camera…) — dùng từ Phase 5.
  requiresSerial        Boolean  @default(false) @map("requires_serial")
  /// Bảo hành mặc định khi tạo sản phẩm mới trong nhóm (tháng).
  defaultWarrantyMonths Int?     @map("default_warranty_months")
  /// Thuế suất mặc định (%) khi tạo sản phẩm mới trong nhóm.
  defaultVatRate        Decimal? @map("default_vat_rate") @db.Decimal(7, 4)
  sortOrder             Int      @default(0) @map("sort_order")
  status                String   @default("hoat-dong") @db.VarChar(30)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy             String?  @map("created_by") @db.Uuid
  updatedBy             String?  @map("updated_by") @db.Uuid

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   ProductCategory?  @relation("NhomCha", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("NhomCha")
  products Product[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("product_categories")
}

/// Thương hiệu (Dell, HP, Hikvision…).
model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   @db.VarChar(50)
  name      String   @db.VarChar(255)
  website   String?  @db.VarChar(255)
  note      String?  @db.Text
  status    String   @default("hoat-dong") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, code])
  @@map("brands")
}

/// Nhà cung cấp. Mã tự cấp NCC-0001.
model Supplier {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  code              String   @db.VarChar(30)
  name              String   @db.VarChar(255)
  nameNormalized    String   @map("name_normalized") @db.VarChar(255)
  taxCode           String?  @map("tax_code") @db.VarChar(30)
  taxCodeNormalized String?  @map("tax_code_normalized") @db.VarChar(20)
  contactName       String?  @map("contact_name") @db.VarChar(255)
  phone             String?  @db.VarChar(30)
  phoneNormalized   String?  @map("phone_normalized") @db.VarChar(20)
  email             String?  @db.VarChar(255)
  emailNormalized   String?  @map("email_normalized") @db.VarChar(255)
  address           String?  @db.Text
  website           String?  @db.VarChar(255)
  /// Điều khoản thanh toán (mã dữ liệu gốc dieu_khoan_thanh_toan) và số ngày giao hàng thường lệ.
  paymentTerms      String?  @map("payment_terms") @db.VarChar(50)
  leadTimeDays      Int?     @map("lead_time_days")
  note              String?  @db.Text
  status            String   @default("hoat-dong") @db.VarChar(30)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy         String?  @map("created_by") @db.Uuid
  updatedBy         String?  @map("updated_by") @db.Uuid

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prices          SupplierProductPrice[]
  priceHistory    PriceHistory[]
  defaultProducts Product[]              @relation("NhaCungCapMacDinh")
  quotationItems  QuotationItem[]

  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrders       PurchaseOrder[]

  supplierBills    SupplierBill[]
  supplierPayments SupplierPayment[]
  purchaseReturns  PurchaseReturn[]

  @@unique([tenantId, code])
  @@unique([tenantId, taxCodeNormalized])
  @@index([tenantId, status])
  @@index([nameNormalized(ops: raw("gin_trgm_ops"))], type: Gin, map: "suppliers_name_normalized_trgm_idx")
  @@map("suppliers")
}

/// Sản phẩm / dịch vụ bán ra. SKU do người dùng đặt, duy nhất trong doanh nghiệp.
model Product {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  sku               String   @db.VarChar(64)
  /// SKU viết hoa, bỏ khoảng trắng — khóa so trùng (KH-SKU không phân biệt hoa thường).
  skuNormalized     String   @map("sku_normalized") @db.VarChar(64)
  name              String   @db.VarChar(500)
  nameNormalized    String   @map("name_normalized") @db.VarChar(500)
  categoryId        String?  @map("category_id") @db.Uuid
  brandId           String?  @map("brand_id") @db.Uuid
  model             String?  @db.VarChar(255)
  description       String?  @db.Text
  /// Thông số kỹ thuật: cấu trúc khác nhau theo nhóm hàng nên để JSON (khóa → giá trị).
  specifications    Json?
  /// Đơn vị tính — mã dữ liệu gốc don_vi_tinh.
  unit              String?  @db.VarChar(50)
  /// Giá vốn tham chiếu (giá nhập gần nhất hoặc giá chuẩn). Giá vốn thực của từng lần nhập ở Phase 5.
  costPrice         Decimal? @map("cost_price") @db.Decimal(18, 2)
  sellingPrice      Decimal? @map("selling_price") @db.Decimal(18, 2)
  vatRate           Decimal  @default(10) @map("vat_rate") @db.Decimal(7, 4)
  warrantyMonths    Int?     @map("warranty_months")
  requiresSerial    Boolean  @default(false) @map("requires_serial")
  /// Có theo dõi tồn kho không. Dịch vụ, phần mềm, công lắp đặt thì tắt (Phase 5).
  quanLyTon         Boolean  @default(true) @map("quan_ly_ton")
  /// Mức tồn tối thiểu để cảnh báo sắp hết hàng (Phase 5). Bỏ trống = không cảnh báo.
  minStock          Decimal? @map("min_stock") @db.Decimal(18, 3)
  defaultSupplierId String?  @map("default_supplier_id") @db.Uuid
  /// hoat-dong | ngung-kinh-doanh
  status            String   @default("hoat-dong") @db.VarChar(30)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy         String?  @map("created_by") @db.Uuid
  updatedBy         String?  @map("updated_by") @db.Uuid

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category        ProductCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand           Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  defaultSupplier Supplier?              @relation("NhaCungCapMacDinh", fields: [defaultSupplierId], references: [id], onDelete: SetNull)
  supplierPrices  SupplierProductPrice[]
  priceHistory    PriceHistory[]
  quotationItems  QuotationItem[]
  salesOrderItems SalesOrderItem[]
  balances        InventoryBalance[]
  inventoryTxns   InventoryTransaction[]
  deliveryItems   DeliveryItem[]
  serials         SerialNumber[]
  warranties      Warranty[]
  invoiceItems    InvoiceItem[]

  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems   PurchaseOrderItem[]

  supplierBillItems       SupplierBillItem[]
  salesReturnItems        SalesReturnItem[]    @relation("TraHangBanSanPham")
  salesReturnReplacements SalesReturnItem[]    @relation("TraHangBanHangThayThe")
  purchaseReturnItems     PurchaseReturnItem[] @relation("TraHangMuaSanPham")
  stockTransferItems      StockTransferItem[]  @relation("ChuyenKhoSanPham")

  @@unique([tenantId, skuNormalized])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@index([tenantId, brandId])
  @@index([nameNormalized(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_normalized_trgm_idx")
  @@index([skuNormalized(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_sku_normalized_trgm_idx")
  @@map("products")
}

/// Giá mua của một sản phẩm từ một nhà cung cấp — mỗi cặp một dòng, cập nhật tại chỗ;
/// mọi lần đổi giá đều ghi thêm một dòng `price_history`.
model SupplierProductPrice {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  supplierId    String    @map("supplier_id") @db.Uuid
  purchasePrice Decimal   @map("purchase_price") @db.Decimal(18, 2)
  currency      String    @default("VND") @db.VarChar(3)
  /// con-hang | het-hang | dat-truoc | khong-ro
  availability  String    @default("khong-ro") @db.VarChar(20)
  leadTimeDays  Int?      @map("lead_time_days")
  /// Mã báo giá / tệp giá của nhà cung cấp, để truy ngược.
  reference     String?   @db.VarChar(255)
  note          String?   @db.Text
  validFrom     DateTime? @map("valid_from") @db.Date
  validTo       DateTime? @map("valid_to") @db.Date
  status        String    @default("hoat-dong") @db.VarChar(30)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@unique([tenantId, productId, supplierId])
  @@index([tenantId, supplierId])
  @@index([tenantId, productId, purchasePrice])
  @@map("supplier_product_prices")
}

/// Lịch sử giá — CHỈ GHI THÊM (trigger chặn sửa/xóa). Không bao giờ đè mất giá cũ.
model PriceHistory {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  /// cost | selling | supplier
  priceType  String   @map("price_type") @db.VarChar(20)
  supplierId String?  @map("supplier_id") @db.Uuid
  oldPrice   Decimal? @map("old_price") @db.Decimal(18, 2)
  newPrice   Decimal? @map("new_price") @db.Decimal(18, 2)
  currency   String   @default("VND") @db.VarChar(3)
  reason     String?  @db.VarChar(255)
  /// thu-cong | nhap-csv | he-thong
  source     String   @default("thu-cong") @db.VarChar(20)
  changedBy  String?  @map("changed_by") @db.Uuid
  changedAt  DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([tenantId, productId, changedAt(sort: Desc)])
  @@index([tenantId, supplierId, changedAt(sort: Desc)])
  @@map("price_history")
}

/// Một lần nhập tệp CSV: kết quả từng dòng để người nhập biết dòng nào hỏng vì sao.
model ImportJob {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// san-pham | gia-nha-cung-cap
  type        String   @db.VarChar(30)
  fileName    String   @map("file_name") @db.VarChar(255)
  /// xem-truoc | da-nhap | that-bai
  status      String   @default("xem-truoc") @db.VarChar(20)
  totalRows   Int      @default(0) @map("total_rows")
  okRows      Int      @default(0) @map("ok_rows")
  errorRows   Int      @default(0) @map("error_rows")
  createdRows Int      @default(0) @map("created_rows")
  updatedRows Int      @default(0) @map("updated_rows")
  /// [{ dong, loi }] — tối đa 200 dòng lỗi đầu tiên.
  errors      Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?  @map("created_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("import_jobs")
}

// ===========================================================================
// Phase 4 — Báo giá (20/09/2026)
//
// Mục 10–14 prompt 20/09. Một báo giá (`quotations`) là đầu phiếu; mỗi lần sửa sau khi
// đã gửi sinh một PHIÊN BẢN mới (`quotation_versions`) — lịch sử không mất.
// Luật nghiệp vụ: BUSINESS_RULES.md mục 5.
// ===========================================================================

/// Đầu phiếu báo giá. Số QT-2026-0001, đánh lại theo năm.
model Quotation {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  number           String   @db.VarChar(30)
  customerId       String   @map("customer_id") @db.Uuid
  contactId        String?  @map("contact_id") @db.Uuid
  opportunityId    String?  @map("opportunity_id") @db.Uuid
  ownerId          String   @map("owner_id") @db.Uuid
  /// Phiên bản đang hiệu lực (bản mới nhất).
  currentVersionId String?  @unique @map("current_version_id") @db.Uuid
  /// Trạng thái của phiên bản hiện hành, chép lại để lọc danh sách không phải nối bảng.
  status           String   @default("DRAFT") @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?  @map("created_by") @db.Uuid
  updatedBy        String?  @map("updated_by") @db.Uuid

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contact        Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity    Opportunity?       @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  owner          User               @relation("BaoGiaPhuTrach", fields: [ownerId], references: [id], onDelete: Restrict)
  versions       QuotationVersion[] @relation("PhienBanCuaBaoGia")
  currentVersion QuotationVersion?  @relation("PhienBanHienHanh", fields: [currentVersionId], references: [id], onDelete: SetNull)
  salesOrders    SalesOrder[]

  @@unique([tenantId, number])
  @@index([tenantId, ownerId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("quotations")
}

/// Một phiên bản báo giá: QT-2026-0001-V2. Đã gửi thì đóng băng, sửa = phiên bản mới.
model QuotationVersion {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  quotationId   String    @map("quotation_id") @db.Uuid
  versionNo     Int       @map("version_no")
  /// DRAFT | PENDING_APPROVAL | APPROVED | SENT | VIEWED | NEGOTIATING | ACCEPTED | REJECTED | EXPIRED | SUPERSEDED
  status        String    @default("DRAFT") @db.VarChar(20)
  /// Mã dữ liệu gốc dieu_khoan_thanh_toan / dieu_khoan_giao_hang; bảo hành ghi tự do.
  paymentTerms  String?   @map("payment_terms") @db.VarChar(50)
  deliveryTerms String?   @map("delivery_terms") @db.VarChar(50)
  warrantyTerms String?   @map("warranty_terms") @db.Text
  validUntil    DateTime? @map("valid_until") @db.Date
  notes         String?   @db.Text
  /// Ảnh chụp số tiền tại thời điểm tính — giữ nguyên dù giá sản phẩm đổi sau này.
  subtotal      Decimal   @default(0) @db.Decimal(18, 2)
  discountTotal Decimal   @default(0) @map("discount_total") @db.Decimal(18, 2)
  vatTotal      Decimal   @default(0) @map("vat_total") @db.Decimal(18, 2)
  total         Decimal   @default(0) @db.Decimal(18, 2)
  costTotal     Decimal   @default(0) @map("cost_total") @db.Decimal(18, 2)
  grossProfit   Decimal   @default(0) @map("gross_profit") @db.Decimal(18, 2)
  /// Biên lợi nhuận gộp %, null khi doanh thu bằng 0 (chưa tính được).
  grossMargin   Decimal?  @map("gross_margin") @db.Decimal(7, 4)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote  String?   @map("decision_note") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotation   Quotation           @relation("PhienBanCuaBaoGia", fields: [quotationId], references: [id], onDelete: Cascade)
  laHienHanh  Quotation?          @relation("PhienBanHienHanh")
  items       QuotationItem[]
  approvals   QuotationApproval[]
  salesOrders SalesOrder[]

  @@unique([quotationId, versionNo])
  @@index([tenantId, status])
  @@map("quotation_versions")
}

/// Dòng hàng của một phiên bản báo giá. Giá vốn chụp tại lúc lập.
model QuotationItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  versionId   String   @map("version_id") @db.Uuid
  lineNo      Int      @map("line_no")
  productId   String?  @map("product_id") @db.Uuid
  /// Chụp lại SKU và tên tại thời điểm lập — chứng từ đã gửi khách không đổi theo danh mục.
  sku         String?  @db.VarChar(64)
  name        String   @db.VarChar(500)
  description String?  @db.Text
  quantity    Decimal  @default(1) @db.Decimal(18, 3)
  unit        String?  @db.VarChar(50)
  unitPrice   Decimal  @default(0) @map("unit_price") @db.Decimal(18, 2)
  discountPct Decimal  @default(0) @map("discount_pct") @db.Decimal(7, 4)
  vatRate     Decimal  @default(10) @map("vat_rate") @db.Decimal(7, 4)
  unitCost    Decimal  @default(0) @map("unit_cost") @db.Decimal(18, 2)
  supplierId  String?  @map("supplier_id") @db.Uuid
  lineTotal   Decimal  @default(0) @map("line_total") @db.Decimal(18, 2)
  lineCost    Decimal  @default(0) @map("line_cost") @db.Decimal(18, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version    QuotationVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  product    Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  supplier   Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  orderItems SalesOrderItem[]

  @@unique([versionId, lineNo])
  @@index([tenantId, productId])
  @@map("quotation_items")
}

/// Một lần xin duyệt báo giá dưới ngưỡng biên lợi nhuận. Chụp cả ngưỡng lúc xin.
model QuotationApproval {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  versionId          String    @map("version_id") @db.Uuid
  /// margin_below_threshold | threshold_not_set | manual
  requiredReason     String    @map("required_reason") @db.VarChar(40)
  marginAtRequest    Decimal?  @map("margin_at_request") @db.Decimal(7, 4)
  thresholdAtRequest Decimal?  @map("threshold_at_request") @db.Decimal(7, 4)
  requestedBy        String    @map("requested_by") @db.Uuid
  requestedAt        DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedBy          String?   @map("decided_by") @db.Uuid
  /// cho-duyet | tu-choi
  decision           String?   @db.VarChar(20)
  decidedAt          DateTime? @map("decided_at") @db.Timestamptz(6)
  comment            String?   @db.Text

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version QuotationVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([tenantId, decision])
  @@index([versionId])
  @@map("quotation_approvals")
}

// ---------------------------------------------------------------------------
// Phase 5 — Đơn hàng và kho (mục 15–16 prompt 20/09)
//
// Đơn hàng sinh từ một phiên bản báo giá KHÁCH ĐÃ CHẤP NHẬN: dòng hàng được CHÉP
// sang, không tham chiếu, vì đơn là chứng từ riêng — báo giá sửa sau cũng không
// được làm đổi đơn. Vẫn giữ `quotation_item_id` để truy ngược.
//
// Kho: `inventory_balances` là số dư hiện tại, `inventory_transactions` là sổ cái
// CHỈ GHI THÊM. Hai thứ luôn đi cùng một giao dịch CSDL, nên số dư luôn cộng đúng
// bằng tổng sổ cái (có bài thử đối soát).
// ---------------------------------------------------------------------------

/// Kho hàng. Doanh nghiệp có thể có nhiều kho; một kho được đánh dấu mặc định.
model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   @db.VarChar(30)
  name      String   @db.VarChar(255)
  address   String?  @db.Text
  note      String?  @db.Text
  isDefault Boolean  @default(false) @map("is_default")
  status    String   @default("hoat-dong") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  balances     InventoryBalance[]
  transactions InventoryTransaction[]
  serials      SerialNumber[]
  deliveries   Delivery[]

  purchaseOrders  PurchaseOrder[]
  goodsReceipts   GoodsReceipt[]
  salesReturns    SalesReturn[]
  purchaseReturns PurchaseReturn[]
  chuyenKhoDi     StockTransfer[]  @relation("ChuyenKhoNguon")
  chuyenKhoDen    StockTransfer[]  @relation("ChuyenKhoDich")

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("warehouses")
}

/// Đơn hàng bán. Số DH-2026-0001.
model SalesOrder {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  number             String    @db.VarChar(30)
  customerId         String    @map("customer_id") @db.Uuid
  contactId          String?   @map("contact_id") @db.Uuid
  /// Một báo giá chỉ có một đơn chưa hủy (chỉ mục riêng phần `sales_orders_bao_gia_dang_hoat_dong_key`
  /// trong migration 0.16.1 — TV-BH-08).
  quotationId        String?   @map("quotation_id") @db.Uuid
  quotationVersionId String?   @map("quotation_version_id") @db.Uuid
  opportunityId      String?   @map("opportunity_id") @db.Uuid
  ownerId            String    @map("owner_id") @db.Uuid
  /// DRAFT | CONFIRMED | PARTIALLY_DELIVERED | DELIVERED | CANCELLED
  status             String    @default("DRAFT") @db.VarChar(20)
  orderDate          DateTime  @default(now()) @map("order_date") @db.Date
  expectedDate       DateTime? @map("expected_date") @db.Date
  deliveryAddress    String?   @map("delivery_address") @db.Text
  /// Mã dữ liệu gốc dieu_khoan_thanh_toan / dieu_khoan_giao_hang.
  paymentTerms       String?   @map("payment_terms") @db.VarChar(50)
  deliveryTerms      String?   @map("delivery_terms") @db.VarChar(50)
  notes              String?   @db.Text
  /// Ảnh chụp số tiền của đơn — tính lại mỗi lần sửa dòng hàng lúc còn nháp.
  subtotal           Decimal   @default(0) @db.Decimal(18, 2)
  discountTotal      Decimal   @default(0) @map("discount_total") @db.Decimal(18, 2)
  vatTotal           Decimal   @default(0) @map("vat_total") @db.Decimal(18, 2)
  total              Decimal   @default(0) @db.Decimal(18, 2)
  costTotal          Decimal   @default(0) @map("cost_total") @db.Decimal(18, 2)
  grossProfit        Decimal   @default(0) @map("gross_profit") @db.Decimal(18, 2)
  grossMargin        Decimal?  @map("gross_margin") @db.Decimal(7, 4)
  confirmedAt        DateTime? @map("confirmed_at") @db.Timestamptz(6)
  confirmedBy        String?   @map("confirmed_by") @db.Uuid
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy        String?   @map("cancelled_by") @db.Uuid
  cancelReason       String?   @map("cancel_reason") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          String?   @map("created_by") @db.Uuid
  updatedBy          String?   @map("updated_by") @db.Uuid

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contact          Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  quotation        Quotation?        @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  quotationVersion QuotationVersion? @relation(fields: [quotationVersionId], references: [id], onDelete: SetNull)
  opportunity      Opportunity?      @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  owner            User              @relation("DonHangPhuTrach", fields: [ownerId], references: [id], onDelete: Restrict)
  items            SalesOrderItem[]
  deliveries       Delivery[]
  warranties       Warranty[]
  projects         Project[]
  tickets          SupportTicket[]
  invoices         Invoice[]

  purchaseRequests PurchaseRequest[]
  salesReturns     SalesReturn[]

  @@unique([tenantId, number])
  @@index([tenantId, ownerId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("sales_orders")
}

/// Dòng hàng của đơn. `deliveredQty` cộng dồn theo từng phiếu xuất.
model SalesOrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  lineNo          Int      @map("line_no")
  productId       String?  @map("product_id") @db.Uuid
  /// Dòng báo giá đã sinh ra dòng này — để truy ngược, không để đọc số tiền.
  quotationItemId String?  @map("quotation_item_id") @db.Uuid
  sku             String?  @db.VarChar(64)
  name            String   @db.VarChar(500)
  description     String?  @db.Text
  quantity        Decimal  @default(1) @db.Decimal(18, 3)
  deliveredQty    Decimal  @default(0) @map("delivered_qty") @db.Decimal(18, 3)
  unit            String?  @db.VarChar(50)
  unitPrice       Decimal  @default(0) @map("unit_price") @db.Decimal(18, 2)
  discountPct     Decimal  @default(0) @map("discount_pct") @db.Decimal(7, 4)
  vatRate         Decimal  @default(10) @map("vat_rate") @db.Decimal(7, 4)
  unitCost        Decimal  @default(0) @map("unit_cost") @db.Decimal(18, 2)
  lineTotal       Decimal  @default(0) @map("line_total") @db.Decimal(18, 2)
  lineCost        Decimal  @default(0) @map("line_cost") @db.Decimal(18, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order         SalesOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  quotationItem QuotationItem?    @relation(fields: [quotationItemId], references: [id], onDelete: SetNull)
  deliveryItems DeliveryItem[]
  serials       SerialNumber[]
  warranties    Warranty[]
  invoiceItems  InvoiceItem[]
  returnItems   SalesReturnItem[]

  @@unique([orderId, lineNo])
  @@index([tenantId, productId])
  @@map("sales_order_items")
}

/// Số dư tồn của một sản phẩm trong một kho. Hàng bán được = onHand − reserved (tính ở service).
model InventoryBalance {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  onHand      Decimal  @default(0) @map("on_hand") @db.Decimal(18, 3)
  /// Đã giữ chỗ cho đơn đã xác nhận: còn trong kho nhưng không bán cho người khác được.
  reserved    Decimal  @default(0) @db.Decimal(18, 3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([tenantId, warehouseId, productId])
  @@index([tenantId, productId])
  @@map("inventory_balances")
}

/// Sổ cái kho — CHỈ GHI THÊM (trigger chặn sửa/xóa). Mỗi dòng ghi rõ tác động lên số dư.
model InventoryTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  warehouseId   String   @map("warehouse_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  /// nhap | xuat | giu-cho | nha-giu-cho | dieu-chinh
  type          String   @db.VarChar(20)
  /// Luôn dương; chiều tác động nằm ở hai cột delta.
  quantity      Decimal  @db.Decimal(18, 3)
  onHandDelta   Decimal  @default(0) @map("on_hand_delta") @db.Decimal(18, 3)
  reservedDelta Decimal  @default(0) @map("reserved_delta") @db.Decimal(18, 3)
  /// Số dư thực tế sau giao dịch — để đối soát sổ cái với số dư.
  onHandAfter   Decimal  @map("on_hand_after") @db.Decimal(18, 3)
  reservedAfter Decimal  @map("reserved_after") @db.Decimal(18, 3)
  unitCost      Decimal? @map("unit_cost") @db.Decimal(18, 2)
  /// don-hang | phieu-xuat | dieu-chinh | nhap-kho
  refType       String?  @map("ref_type") @db.VarChar(30)
  refId         String?  @map("ref_id") @db.Uuid
  refNumber     String?  @map("ref_number") @db.VarChar(30)
  reason        String?  @db.VarChar(100)
  note          String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?  @map("created_by") @db.Uuid

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, productId, createdAt])
  @@index([tenantId, warehouseId, createdAt])
  @@index([tenantId, refType, refId])
  @@map("inventory_transactions")
}

/// Phiếu xuất giao hàng cho một đơn. Ghi sổ kho ngay khi lập (không có bước nháp).
model Delivery {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  number       String   @db.VarChar(30)
  orderId      String   @map("order_id") @db.Uuid
  warehouseId  String   @map("warehouse_id") @db.Uuid
  deliveredAt  DateTime @default(now()) @map("delivered_at") @db.Timestamptz(6)
  receiverName String?  @map("receiver_name") @db.VarChar(255)
  note         String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?  @map("created_by") @db.Uuid

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order        SalesOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items        DeliveryItem[]
  serials      SerialNumber[]
  warranties   Warranty[]
  salesReturns SalesReturn[]

  @@unique([tenantId, number])
  @@index([tenantId, orderId])
  @@map("deliveries")
}

/// Dòng của phiếu xuất: xuất bao nhiêu cho dòng nào của đơn.
model DeliveryItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  deliveryId  String   @map("delivery_id") @db.Uuid
  orderItemId String   @map("order_item_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  quantity    Decimal  @db.Decimal(18, 3)
  note        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  delivery  Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderItem SalesOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  product   Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([tenantId, deliveryId])
  @@map("delivery_items")
}

/// Số sê-ri của hàng quản lý theo máy. Duy nhất theo (tenant, sản phẩm, sê-ri).
model SerialNumber {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  serial              String   @db.VarChar(100)
  warehouseId         String?  @map("warehouse_id") @db.Uuid
  /// trong-kho | da-ban | tra-lai
  status              String   @default("trong-kho") @db.VarChar(20)
  salesOrderItemId    String?  @map("sales_order_item_id") @db.Uuid
  deliveryId          String?  @map("delivery_id") @db.Uuid
  /// Dòng phiếu trả hàng đã nhận lại máy này (TH-05).
  salesReturnItemId   String?  @map("sales_return_item_id") @db.Uuid
  /// Dòng phiếu chuyển kho đang mang máy này đi (CK-05).
  stockTransferItemId String?  @map("stock_transfer_item_id") @db.Uuid
  note                String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy           String?  @map("created_by") @db.Uuid

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse         Warehouse?         @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  salesOrderItem    SalesOrderItem?    @relation(fields: [salesOrderItemId], references: [id], onDelete: SetNull)
  delivery          Delivery?          @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  salesReturnItem   SalesReturnItem?   @relation(fields: [salesReturnItemId], references: [id], onDelete: SetNull)
  stockTransferItem StockTransferItem? @relation(fields: [stockTransferItemId], references: [id], onDelete: SetNull)
  warranty          Warranty?
  tickets           SupportTicket[]

  @@unique([tenantId, productId, serial])
  @@index([tenantId, status])
  @@index([tenantId, warehouseId])
  @@map("serial_numbers")
}

// ---------------------------------------------------------------------------
// Phase 6 — Dự án, bảo hành, phiếu hỗ trợ (mục 17–18 prompt 20/09)
//
// Chuỗi tiếp nối Phase 5: hàng xuất kho → bảo hành tự sinh theo từng máy (số sê-ri)
// → khách gọi thì mở phiếu hỗ trợ gắn đúng máy đó. Dự án triển khai đi ra từ đơn hàng,
// chia thành hạng mục và kết thúc bằng nghiệm thu.
// ---------------------------------------------------------------------------

/// Bảo hành của một máy (hoặc một dòng hàng không có sê-ri). Sinh tự động khi xuất kho.
model Warranty {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  customerId       String    @map("customer_id") @db.Uuid
  productId        String?   @map("product_id") @db.Uuid
  /// Bảo hành đã hủy thì nhả sê-ri về NULL (CHECK `warranties_huy_nha_serial_check`, TV-BH-06) —
  /// máy khách trả về bán lại được; số sê-ri dạng chữ vẫn giữ ở cột `serial`.
  serialNumberId   String?   @unique @map("serial_number_id") @db.Uuid
  /// Chụp lại số sê-ri và tên hàng lúc giao — chứng từ bảo hành không đổi theo danh mục.
  serial           String?   @db.VarChar(100)
  productName      String    @map("product_name") @db.VarChar(500)
  salesOrderId     String?   @map("sales_order_id") @db.Uuid
  salesOrderItemId String?   @map("sales_order_item_id") @db.Uuid
  deliveryId       String?   @map("delivery_id") @db.Uuid
  months           Int       @default(0)
  startDate        DateTime  @map("start_date") @db.Date
  /// Hết hạn = ngày bắt đầu + số tháng. Không có bảo hành (0 tháng) thì bằng ngày bắt đầu.
  endDate          DateTime  @map("end_date") @db.Date
  /// hieu-luc | het-han | huy — trạng thái ghi lại, còn hạn hay không thì tính theo ngày.
  status           String    @default("hieu-luc") @db.VarChar(20)
  note             String?   @db.Text
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?   @map("created_by") @db.Uuid

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  serialNumber   SerialNumber?   @relation(fields: [serialNumberId], references: [id], onDelete: SetNull)
  salesOrder     SalesOrder?     @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  salesOrderItem SalesOrderItem? @relation(fields: [salesOrderItemId], references: [id], onDelete: SetNull)
  delivery       Delivery?       @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  tickets        SupportTicket[]
  renewals       Renewal[]

  @@index([tenantId, customerId])
  @@index([tenantId, endDate])
  @@index([tenantId, serial])
  @@map("warranties")
}

/// Dự án triển khai cho khách: lắp đặt, thi công, chuyển giao. Đi ra từ một đơn hàng.
model Project {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  code           String    @db.VarChar(30)
  name           String    @db.VarChar(500)
  customerId     String    @map("customer_id") @db.Uuid
  salesOrderId   String?   @map("sales_order_id") @db.Uuid
  /// Người chịu trách nhiệm dự án (quản lý dự án hoặc trưởng phòng kỹ thuật).
  managerId      String    @map("manager_id") @db.Uuid
  /// PLANNING | IN_PROGRESS | ON_HOLD | ACCEPTED | CANCELLED
  status         String    @default("PLANNING") @db.VarChar(20)
  description    String?   @db.Text
  startDate      DateTime? @map("start_date") @db.Date
  dueDate        DateTime? @map("due_date") @db.Date
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)
  acceptedBy     String?   @map("accepted_by") @db.Uuid
  acceptanceNote String?   @map("acceptance_note") @db.Text
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason   String?   @map("cancel_reason") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrder SalesOrder?        @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  manager    User               @relation("DuAnPhuTrach", fields: [managerId], references: [id], onDelete: Restrict)
  milestones ProjectMilestone[]
  tasks      Task[]
  tickets    SupportTicket[]
  invoices   Invoice[]

  @@unique([tenantId, code])
  @@index([tenantId, managerId, status])
  @@index([tenantId, customerId])
  @@map("projects")
}

/// Hạng mục / mốc của dự án. Dự án xong khi mọi hạng mục xong và khách nghiệm thu.
model ProjectMilestone {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  name      String    @db.VarChar(500)
  /// chua-lam | dang-lam | xong
  status    String    @default("chua-lam") @db.VarChar(20)
  dueDate   DateTime? @map("due_date") @db.Date
  doneAt    DateTime? @map("done_at") @db.Timestamptz(6)
  note      String?   @db.Text
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId])
  @@map("project_milestones")
}

/// Phiếu hỗ trợ khách: bảo hành, sự cố, yêu cầu, bảo trì. Số HT-2026-0001.
model SupportTicket {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  number          String    @db.VarChar(30)
  customerId      String    @map("customer_id") @db.Uuid
  contactId       String?   @map("contact_id") @db.Uuid
  warrantyId      String?   @map("warranty_id") @db.Uuid
  serialNumberId  String?   @map("serial_number_id") @db.Uuid
  salesOrderId    String?   @map("sales_order_id") @db.Uuid
  projectId       String?   @map("project_id") @db.Uuid
  /// bao-hanh | su-co | yeu-cau | bao-tri
  type            String    @db.VarChar(20)
  /// khan | cao | trung-binh | thap
  priority        String    @default("trung-binh") @db.VarChar(20)
  /// MOI | DANG_XU_LY | CHO_KHACH | HOAN_THANH | DONG | HUY
  status          String    @default("MOI") @db.VarChar(20)
  title           String    @db.VarChar(500)
  description     String?   @db.Text
  /// Người tiếp nhận (CSKH) và kỹ thuật viên đang xử lý.
  ownerId         String    @map("owner_id") @db.Uuid
  assigneeId      String?   @map("assignee_id") @db.Uuid
  /// Hạn cam kết tính từ ngưỡng SLA lúc mở phiếu — chụp lại để sau đổi ngưỡng không làm đổi lịch sử.
  responseDueAt   DateTime? @map("response_due_at") @db.Timestamptz(6)
  resolveDueAt    DateTime? @map("resolve_due_at") @db.Timestamptz(6)
  firstResponseAt DateTime? @map("first_response_at") @db.Timestamptz(6)
  /// Mốc xử lý xong hiện hành — xóa khi mở lại phiếu (TV-BH-12) để nhắc SLA chạy lại.
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)
  /// Mốc xử lý xong LẦN ĐẦU, không đổi khi mở lại — để báo cáo biết phiếu từng "xong" rồi bị mở lại.
  firstResolvedAt DateTime? @map("first_resolved_at") @db.Timestamptz(6)
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(6)
  resolution      String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?   @map("created_by") @db.Uuid
  updatedBy       String?   @map("updated_by") @db.Uuid

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contact      Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  warranty     Warranty?            @relation(fields: [warrantyId], references: [id], onDelete: SetNull)
  serialNumber SerialNumber?        @relation(fields: [serialNumberId], references: [id], onDelete: SetNull)
  salesOrder   SalesOrder?          @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  project      Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  owner        User                 @relation("PhieuHoTroTiepNhan", fields: [ownerId], references: [id], onDelete: Restrict)
  assignee     User?                @relation("PhieuHoTroXuLy", fields: [assigneeId], references: [id], onDelete: SetNull)
  events       SupportTicketEvent[]

  @@unique([tenantId, number])
  @@index([tenantId, status, priority])
  @@index([tenantId, assigneeId, status])
  @@index([tenantId, customerId])
  @@map("support_tickets")
}

/// Diễn biến xử lý một phiếu — CHỈ GHI THÊM, là bằng chứng đã làm gì cho khách.
model SupportTicketEvent {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  /// tiep-nhan | ghi-chu | giao-viec | doi-trang-thai | phan-hoi-khach | hoan-thanh | dong | mo-lai
  type       String   @db.VarChar(20)
  content    String?  @db.Text
  fromStatus String?  @map("from_status") @db.VarChar(20)
  toStatus   String?  @map("to_status") @db.VarChar(20)
  actorId    String?  @map("actor_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([tenantId, ticketId, createdAt])
  @@map("support_ticket_events")
}

// ---------------------------------------------------------------------------
// Phase 7 — Tài chính quản trị (mục 19–20 prompt 20/09)
//
// Hóa đơn sinh từ đơn hàng, thu tiền ghi vào phiếu thu, một phiếu thu phân bổ được
// cho nhiều hóa đơn. **Công nợ KHÔNG lưu thành bảng**: còn nợ = tổng hóa đơn − tổng
// phân bổ đã thu, tính ngay lúc đọc (DATABASE.md phần B, mục 4 master prompt: một
// nguồn dữ liệu, không giữ hai nơi cùng một con số).
// ---------------------------------------------------------------------------

/// Hóa đơn bán hàng. Số HD-2026-0001. Một đơn hàng chỉ một hóa đơn còn hiệu lực (chỉ mục
/// riêng phần `invoices_mot_hieu_luc_moi_don` trong migration 0.16.1).
model Invoice {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  number        String    @db.VarChar(30)
  customerId    String    @map("customer_id") @db.Uuid
  salesOrderId  String?   @map("sales_order_id") @db.Uuid
  projectId     String?   @map("project_id") @db.Uuid
  ownerId       String    @map("owner_id") @db.Uuid
  /// DRAFT | ISSUED | CANCELLED — "đã thu đủ hay chưa" TÍNH từ phân bổ, không lưu.
  status        String    @default("DRAFT") @db.VarChar(20)
  issueDate     DateTime? @map("issue_date") @db.Date
  dueDate       DateTime? @map("due_date") @db.Date
  /// Mã dữ liệu gốc dieu_khoan_thanh_toan (chép từ đơn hàng).
  paymentTerms  String?   @map("payment_terms") @db.VarChar(50)
  notes         String?   @db.Text
  subtotal      Decimal   @default(0) @db.Decimal(18, 2)
  discountTotal Decimal   @default(0) @map("discount_total") @db.Decimal(18, 2)
  vatTotal      Decimal   @default(0) @map("vat_total") @db.Decimal(18, 2)
  total         Decimal   @default(0) @db.Decimal(18, 2)
  costTotal     Decimal   @default(0) @map("cost_total") @db.Decimal(18, 2)
  issuedAt      DateTime? @map("issued_at") @db.Timestamptz(6)
  issuedBy      String?   @map("issued_by") @db.Uuid
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason  String?   @map("cancel_reason") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrder        SalesOrder?             @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  project           Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  owner             User                    @relation("HoaDonPhuTrach", fields: [ownerId], references: [id], onDelete: Restrict)
  items             InvoiceItem[]
  allocations       PaymentAllocation[]
  returnAllocations SalesReturnAllocation[]

  @@unique([tenantId, number])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, customerId])
  @@map("invoices")
}

/// Dòng hóa đơn — chép từ dòng đơn hàng lúc lập, giữ liên kết để truy ngược.
model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  lineNo      Int      @map("line_no")
  orderItemId String?  @map("order_item_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  sku         String?  @db.VarChar(64)
  name        String   @db.VarChar(500)
  quantity    Decimal  @default(1) @db.Decimal(18, 3)
  unit        String?  @db.VarChar(50)
  unitPrice   Decimal  @default(0) @map("unit_price") @db.Decimal(18, 2)
  discountPct Decimal  @default(0) @map("discount_pct") @db.Decimal(7, 4)
  vatRate     Decimal  @default(10) @map("vat_rate") @db.Decimal(7, 4)
  unitCost    Decimal  @default(0) @map("unit_cost") @db.Decimal(18, 2)
  lineTotal   Decimal  @default(0) @map("line_total") @db.Decimal(18, 2)
  lineCost    Decimal  @default(0) @map("line_cost") @db.Decimal(18, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice   Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderItem SalesOrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([invoiceId, lineNo])
  @@index([tenantId, productId])
  @@map("invoice_items")
}

/// Phiếu thu tiền của khách. Số PT-2026-0001. Một phiếu phân bổ cho nhiều hóa đơn.
model Payment {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  number       String    @db.VarChar(30)
  customerId   String    @map("customer_id") @db.Uuid
  /// tien-mat | chuyen-khoan | the | bu-tru
  method       String    @db.VarChar(20)
  amount       Decimal   @db.Decimal(18, 2)
  receivedAt   DateTime  @map("received_at") @db.Date
  reference    String?   @db.VarChar(255)
  note         String?   @db.Text
  /// hoat-dong | huy — hủy thì giữ lại bản ghi kèm lý do, không xóa.
  status       String    @default("hoat-dong") @db.VarChar(20)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason String?   @map("cancel_reason") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]

  @@unique([tenantId, number])
  @@index([tenantId, customerId, receivedAt])
  @@map("payments")
}

/// Phân bổ một phiếu thu cho một hóa đơn. Tổng phân bổ của phiếu = số tiền đã thu.
model PaymentAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  invoiceId String   @map("invoice_id") @db.Uuid
  amount    Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([tenantId, invoiceId])
  @@map("payment_allocations")
}

// ---------------------------------------------------------------------------
// Phase 8 — Tự động hóa: thông báo, quy tắc nhắc việc, lần chạy nền, "Việc hôm nay",
// hợp đồng bảo trì định kỳ và gia hạn.
// ---------------------------------------------------------------------------

/// Thông báo trong ứng dụng cho MỘT người. Không gửi ra ngoài (email, Zalo) ở phase này.
model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// Mã loại, ví dụ viec-hom-nay | phieu-duoc-giao | bao-gia-cho-duyet | hoa-don-thu-du.
  type       String    @db.VarChar(50)
  /// thong-tin | canh-bao | khan
  severity   String    @default("thong-tin") @db.VarChar(20)
  title      String    @db.VarChar(300)
  body       String?   @db.Text
  link       String?   @db.VarChar(500)
  objectType String?   @map("object_type") @db.VarChar(50)
  objectId   String?   @map("object_id") @db.Uuid
  /// Khóa chống trùng: cùng người + cùng khóa thì chỉ có một thông báo (bản quét
  /// hằng ngày chạy lại không nhân đôi chuông). Null = không chống trùng.
  dedupeKey  String?   @map("dedupe_key") @db.VarChar(200)
  readAt     DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("ThongBaoCuaNguoiDung", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, dedupeKey])
  @@index([tenantId, userId, readAt, createdAt])
  @@map("notifications")
}

/// Bật/tắt từng quy tắc nhắc việc theo doanh nghiệp. Nội dung quy tắc (quét gì, cần
/// ngưỡng nào) nằm trong mã `src/modules/nhac-viec/quy-tac.ts` — bảng này chỉ giữ công tắc.
model AutomationRule {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String    @db.VarChar(50)
  enabled   Boolean   @default(true)
  note      String?   @db.Text
  lastRunAt DateTime? @map("last_run_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("automation_rules")
}

/// Một lần chạy tác vụ nền. Chỉ có một lần chạy THEO LỊCH cho mỗi ngày (chỉ mục
/// riêng phần `job_runs_lich_moi_ngay` trong migration); chạy tay thì không giới hạn.
model JobRun {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  /// quet-nhac-viec (hiện chỉ có một loại).
  jobCode       String    @map("job_code") @db.VarChar(50)
  /// Ngày nghiệp vụ được quét (giờ Việt Nam), không phải thời điểm chạy.
  forDate       DateTime  @map("for_date") @db.Date
  /// lich | tay
  trigger       String    @default("lich") @db.VarChar(10)
  /// dang-chay | xong | hong
  status        String    @default("dang-chay") @db.VarChar(20)
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(6)
  rulesRun      Int       @default(0) @map("rules_run")
  rulesSkipped  Int       @default(0) @map("rules_skipped")
  itemsCreated  Int       @default(0) @map("items_created")
  notifsCreated Int       @default(0) @map("notifs_created")
  error         String?   @db.Text
  /// Chi tiết từng quy tắc: chạy được không, vì sao bỏ qua, sinh bao nhiêu việc.
  detail        Json      @default("{}")
  startedBy     String?   @map("started_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, jobCode, forDate])
  @@map("job_runs")
}

/// 0.16.1 — nhịp sống của tiến trình hệ thống (QĐ-87, QĐ-88). Bảng TOÀN HỆ THỐNG, không có
/// tenant_id: 'worker' do worker ghi mỗi phút (vai cowork_app), 'sao-luu' do scripts/sao-luu.sh
/// ghi bằng vai chủ sở hữu. Ứng dụng chỉ được ghi dòng 'worker…' (prisma/rls.sql mục 5b).
model SystemHeartbeat {
  name     String    @id @db.VarChar(50)
  lastAt   DateTime  @default(now()) @map("last_at") @db.Timestamptz(6)
  /// Lần ghi gần nhất thành công hay hỏng.
  ok       Boolean   @default(true)
  /// Lần thành công gần nhất — với sao lưu, đây là mốc màn hình dùng để báo đỏ sau 26 giờ.
  lastOkAt DateTime? @map("last_ok_at") @db.Timestamptz(6)
  /// Chi tiết ngắn (phiên bản, tên tệp, lỗi). Không chứa bí mật.
  info     Json      @default("{}")

  @@map("system_heartbeats")
}

/// "Việc hôm nay" — một dòng là một việc bản quét đề nghị cho một người trong một ngày.
/// Đây là GỢI Ý, không phải công việc chính thức (`tasks`); người dùng đánh dấu xong
/// hoặc bỏ qua, và dòng vẫn ở lại để đo xem quy tắc có hữu ích không.
model DailyActionItem {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  forDate    DateTime  @map("for_date") @db.Date
  ruleCode   String    @map("rule_code") @db.VarChar(50)
  /// thong-tin | canh-bao | khan
  severity   String    @default("thong-tin") @db.VarChar(20)
  title      String    @db.VarChar(300)
  /// Vì sao lọt vào danh sách — câu chữ cụ thể, kèm số ngày thật.
  reason     String    @db.Text
  link       String?   @db.VarChar(500)
  objectType String    @map("object_type") @db.VarChar(50)
  objectId   String    @map("object_id") @db.Uuid
  /// mo | xong | bo-qua
  status     String    @default("mo") @db.VarChar(20)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedBy String?   @map("resolved_by") @db.Uuid
  skipReason String?   @map("skip_reason") @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("ViecHomNayCuaNguoiDung", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, forDate, ruleCode, objectType, objectId])
  @@index([tenantId, userId, forDate, status])
  @@map("daily_action_items")
}

/// Hợp đồng bảo trì định kỳ. Mã BT-2026-0001. Kỳ kế tiếp tính từ lần bảo trì gần nhất.
model MaintenanceContract {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  code            String    @db.VarChar(30)
  customerId      String    @map("customer_id") @db.Uuid
  ownerId         String    @map("owner_id") @db.Uuid
  name            String    @db.VarChar(300)
  scope           String?   @db.Text
  startDate       DateTime  @map("start_date") @db.Date
  endDate         DateTime  @map("end_date") @db.Date
  /// Bảo trì mỗi bao nhiêu tháng.
  cycleMonths     Int       @map("cycle_months")
  lastServiceDate DateTime? @map("last_service_date") @db.Date
  nextServiceDate DateTime? @map("next_service_date") @db.Date
  amount          Decimal?  @db.Decimal(18, 2)
  /// hieu-luc | tam-dung | het-han | huy
  status          String    @default("hieu-luc") @db.VarChar(20)
  note            String?   @db.Text
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason    String?   @map("cancel_reason") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?   @map("created_by") @db.Uuid
  updatedBy       String?   @map("updated_by") @db.Uuid

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  owner    User      @relation("BaoTriPhuTrach", fields: [ownerId], references: [id], onDelete: Restrict)
  renewals Renewal[]

  @@unique([tenantId, code])
  @@index([tenantId, nextServiceDate])
  @@index([tenantId, customerId])
  @@map("maintenance_contracts")
}

/// Việc gia hạn sắp tới: bảo hành sắp hết, hợp đồng bảo trì sắp hết. Bản quét sinh ra,
/// người bán chốt bằng cách mở cơ hội. Một nguồn (một bảo hành / một hợp đồng) chỉ có
/// một dòng gia hạn — chạy quét lại không nhân đôi.
model Renewal {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  /// bao-hanh | bao-tri
  sourceType            String   @map("source_type") @db.VarChar(20)
  warrantyId            String?  @map("warranty_id") @db.Uuid
  maintenanceContractId String?  @map("maintenance_contract_id") @db.Uuid
  customerId            String   @map("customer_id") @db.Uuid
  ownerId               String?  @map("owner_id") @db.Uuid
  title                 String   @db.VarChar(300)
  dueDate               DateTime @map("due_date") @db.Date
  /// moi | da-tao-co-hoi | bo-qua
  status                String   @default("moi") @db.VarChar(20)
  opportunityId         String?  @map("opportunity_id") @db.Uuid
  note                  String?  @db.Text
  skipReason            String?  @map("skip_reason") @db.Text
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy             String?  @map("updated_by") @db.Uuid

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warranty            Warranty?            @relation(fields: [warrantyId], references: [id], onDelete: Cascade)
  maintenanceContract MaintenanceContract? @relation(fields: [maintenanceContractId], references: [id], onDelete: Cascade)
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  owner               User?                @relation("GiaHanPhuTrach", fields: [ownerId], references: [id], onDelete: SetNull)
  opportunity         Opportunity?         @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@unique([tenantId, warrantyId, dueDate])
  @@unique([tenantId, maintenanceContractId, dueDate])
  @@index([tenantId, status, dueDate])
  @@map("renewals")
}

// ---------------------------------------------------------------------------
// Phase 9 — Trợ lý AI: hội thoại, tin nhắn, lần gọi công cụ, đề xuất hành động.
// Thiết kế: AI_ARCHITECTURE.md.
// ---------------------------------------------------------------------------

/// Một cuộc hội thoại của MỘT người với trợ lý. Không có hội thoại dùng chung.
model AiConversation {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  title         String   @db.VarChar(300)
  /// Nhà cung cấp và mô hình đã dùng — ghi lại để đối chiếu khi đổi mô hình.
  provider      String?  @db.VarChar(50)
  model         String?  @db.VarChar(100)
  /// dang-mo | da-dong
  status        String   @default("dang-mo") @db.VarChar(20)
  lastMessageAt DateTime @default(now()) @map("last_message_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User        @relation("HoiThoaiCuaNguoiDung", fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]
  actions  AiAction[]

  @@index([tenantId, userId, lastMessageAt])
  @@map("ai_conversations")
}

/// Một lượt trong hội thoại. **Chỉ ghi thêm** (trigger `chan_sua_ai_messages`):
/// lịch sử hỏi đáp là bằng chứng, không được sửa lại cho đẹp.
model AiMessage {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  /// nguoi-dung | tro-ly | he-thong
  role           String   @db.VarChar(20)
  content        String   @db.Text
  /// Số vòng mô hình đã chạy để ra lượt này (0 với tin của người dùng).
  turns          Int      @default(0)
  /// Token vào/ra do nhà cung cấp báo — để theo dõi chi phí, không để tính tiền.
  tokensIn       Int?     @map("tokens_in")
  tokensOut      Int?     @map("tokens_out")
  /// Lỗi nếu lượt này hỏng (hết hạn mức, mất mạng, vượt trần vòng lặp).
  error          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolCalls    AiToolCall[]

  @@index([tenantId, conversationId, createdAt])
  @@map("ai_messages")
}

/// Một lần mô hình gọi công cụ. **Chỉ ghi thêm** — đây là bằng chứng cho luật
/// "mọi con số phải truy được về một lần gọi công cụ" (AI-02).
model AiToolCall {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  messageId  String   @map("message_id") @db.Uuid
  toolName   String   @map("tool_name") @db.VarChar(80)
  /// Tham số mô hình truyền vào, sau khi đã qua lược đồ Zod.
  args       Json     @default("{}")
  /// Kết quả đã rút gọn (cắt bớt để không phình nhật ký).
  result     String?  @db.Text
  /// ok | thieu-quyen | tham-so-sai | loi
  outcome    String   @db.VarChar(20)
  error      String?  @db.Text
  durationMs Int      @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  message AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([tenantId, toolName, createdAt])
  @@map("ai_tool_calls")
}

/// Đề xuất hành động GHI của trợ lý. Trợ lý **không bao giờ** tự chạy: dòng sinh ra ở
/// trạng thái `de-xuat`, người dùng bấm Đồng ý thì service chạy với **quyền của người
/// bấm** và dòng chuyển `da-chay` kèm `approved_by` (AI-03).
model AiAction {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  /// Mã loại hành động, ví dụ tao-nhap-bao-gia | tao-viec.
  actionType     String    @map("action_type") @db.VarChar(50)
  /// Câu mô tả để người duyệt đọc là hiểu sẽ xảy ra gì.
  summary        String    @db.VarChar(500)
  payload        Json      @default("{}")
  /// de-xuat | da-chay | tu-choi
  status         String    @default("de-xuat") @db.VarChar(20)
  /// Bản ghi sinh ra sau khi chạy (báo giá, việc…).
  objectType     String?   @map("object_type") @db.VarChar(50)
  objectId       String?   @map("object_id") @db.Uuid
  approvedBy     String?   @map("approved_by") @db.Uuid
  approvedAt     DateTime? @map("approved_at") @db.Timestamptz(6)
  rejectReason   String?   @map("reject_reason") @db.Text
  error          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@map("ai_actions")
}

// ---------------------------------------------------------------------------
// Mua hàng (phần để lại từ Phase 5): đề nghị mua → đơn mua → nhận hàng vào kho.
// Khép vòng tồn kho: hàng vào kho bằng ĐÚNG hàm ghiSoKho() mà Phase 5 dùng, nên số dư
// và sổ cái không bao giờ lệch nhau.
// ---------------------------------------------------------------------------

/// Đề nghị mua hàng. Số DN-2026-0001. Sinh khi đơn bán thiếu hàng, hoặc lập tay.
model PurchaseRequest {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  number       String    @db.VarChar(30)
  /// Đề nghị vì đơn bán này thiếu hàng (nếu có).
  salesOrderId String?   @map("sales_order_id") @db.Uuid
  requesterId  String    @map("requester_id") @db.Uuid
  /// DRAFT | PENDING_APPROVAL | APPROVED | ORDERED | REJECTED | CANCELLED
  status       String    @default("DRAFT") @db.VarChar(20)
  needByDate   DateTime? @map("need_by_date") @db.Date
  reason       String?   @db.Text
  note         String?   @db.Text
  approvedBy   String?   @map("approved_by") @db.Uuid
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(6)
  decisionNote String?   @map("decision_note") @db.Text
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason String?   @map("cancel_reason") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder?           @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  requester  User                  @relation("DeNghiMuaCua", fields: [requesterId], references: [id], onDelete: Restrict)
  items      PurchaseRequestItem[]
  orders     PurchaseOrder[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  requestId      String   @map("request_id") @db.Uuid
  lineNo         Int      @map("line_no")
  productId      String?  @map("product_id") @db.Uuid
  /// Chụp lại tên lúc đề nghị — danh mục đổi sau không làm đổi chứng từ.
  name           String   @db.VarChar(500)
  sku            String?  @db.VarChar(64)
  quantity       Decimal  @db.Decimal(18, 3)
  unit           String?  @db.VarChar(50)
  /// Giá mua dự kiến, để người duyệt biết đề nghị này tốn bao nhiêu.
  estimatedPrice Decimal  @default(0) @map("estimated_price") @db.Decimal(18, 2)
  /// Nhà cung cấp gợi ý (từ bảng giá nhà cung cấp).
  supplierId     String?  @map("supplier_id") @db.Uuid
  note           String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request            PurchaseRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product            Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  supplier           Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([requestId, lineNo])
  @@index([tenantId, productId])
  @@map("purchase_request_items")
}

/// Đơn mua gửi nhà cung cấp. Số DM-2026-0001.
model PurchaseOrder {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  number        String    @db.VarChar(30)
  supplierId    String    @map("supplier_id") @db.Uuid
  requestId     String?   @map("request_id") @db.Uuid
  ownerId       String    @map("owner_id") @db.Uuid
  /// Kho sẽ nhận hàng về.
  warehouseId   String    @map("warehouse_id") @db.Uuid
  /// DRAFT | SENT | CONFIRMED | PARTIALLY_RECEIVED | RECEIVED | CANCELLED
  status        String    @default("DRAFT") @db.VarChar(20)
  orderDate     DateTime  @default(now()) @map("order_date") @db.Date
  expectedDate  DateTime? @map("expected_date") @db.Date
  /// Mã dữ liệu gốc dieu_khoan_thanh_toan (chép từ nhà cung cấp lúc lập).
  paymentTerms  String?   @map("payment_terms") @db.VarChar(50)
  notes         String?   @db.Text
  /// Ảnh chụp số tiền — tính lại mỗi lần sửa dòng hàng lúc còn nháp.
  subtotal      Decimal   @default(0) @db.Decimal(18, 2)
  discountTotal Decimal   @default(0) @map("discount_total") @db.Decimal(18, 2)
  vatTotal      Decimal   @default(0) @map("vat_total") @db.Decimal(18, 2)
  total         Decimal   @default(0) @db.Decimal(18, 2)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  confirmedAt   DateTime? @map("confirmed_at") @db.Timestamptz(6)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason  String?   @map("cancel_reason") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier  Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  request   PurchaseRequest?    @relation(fields: [requestId], references: [id], onDelete: SetNull)
  owner     User                @relation("DonMuaPhuTrach", fields: [ownerId], references: [id], onDelete: Restrict)
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items     PurchaseOrderItem[]
  receipts  GoodsReceipt[]

  supplierBills SupplierBill[]
  returns       PurchaseReturn[]

  @@unique([tenantId, number])
  @@index([tenantId, status, expectedDate])
  @@index([tenantId, supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  lineNo          Int      @map("line_no")
  requestItemId   String?  @map("request_item_id") @db.Uuid
  productId       String?  @map("product_id") @db.Uuid
  sku             String?  @db.VarChar(64)
  name            String   @db.VarChar(500)
  quantity        Decimal  @db.Decimal(18, 3)
  unit            String?  @db.VarChar(50)
  unitPrice       Decimal  @default(0) @map("unit_price") @db.Decimal(18, 2)
  discountPct     Decimal  @default(0) @map("discount_pct") @db.Decimal(7, 4)
  vatRate         Decimal  @default(10) @map("vat_rate") @db.Decimal(7, 4)
  lineTotal       Decimal  @default(0) @map("line_total") @db.Decimal(18, 2)
  /// Đã nhận bao nhiêu — cộng dồn từ các phiếu nhận, không nhập tay.
  receivedQty     Decimal  @default(0) @map("received_qty") @db.Decimal(18, 3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  requestItem   PurchaseRequestItem? @relation(fields: [requestItemId], references: [id], onDelete: SetNull)
  product       Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  receiptItems  GoodsReceiptItem[]

  supplierBillItems SupplierBillItem[]
  returnItems       PurchaseReturnItem[]

  @@unique([purchaseOrderId, lineNo])
  @@index([tenantId, productId])
  @@map("purchase_order_items")
}

/// Phiếu nhận hàng từ nhà cung cấp. Số NK-2026-0001. Nhận nhiều lần cho một đơn mua.
/// **Không có đường hủy**: ghi sai thì điều chỉnh tồn có lý do (KHO-03), để sổ cái kho
/// luôn là sổ chỉ ghi thêm.
model GoodsReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  number          String   @db.VarChar(30)
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  warehouseId     String   @map("warehouse_id") @db.Uuid
  receivedAt      DateTime @default(now()) @map("received_at") @db.Date
  /// Số hóa đơn / phiếu giao của nhà cung cấp, để đối chiếu sau này.
  supplierDocNo   String?  @map("supplier_doc_no") @db.VarChar(100)
  note            String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?  @map("created_by") @db.Uuid

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items         GoodsReceiptItem[]

  @@unique([tenantId, number])
  @@index([tenantId, purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  receiptId   String   @map("receipt_id") @db.Uuid
  orderItemId String   @map("order_item_id") @db.Uuid
  quantity    Decimal  @db.Decimal(18, 3)
  /// Giá vốn ghi vào sổ kho cho lần nhận này.
  unitCost    Decimal  @default(0) @map("unit_cost") @db.Decimal(18, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receipt   GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderItem PurchaseOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([tenantId, orderItemId])
  @@map("goods_receipt_items")
}

// ---------------------------------------------------------------------------
// Công nợ phải trả: hóa đơn nhà cung cấp và phiếu chi.
// Đối xứng với Phase 7 (hóa đơn bán ra và phiếu thu), và cũng KHÔNG lưu công nợ thành
// cột — còn phải trả = hóa đơn đã ghi nhận trừ tiền đã chi (QĐ-09).
// ---------------------------------------------------------------------------

/// Hóa đơn nhà cung cấp gửi cho mình. Số HM-2026-0001 (số nội bộ, khác số của nhà cung cấp).
/// Một đơn mua chỉ một hóa đơn còn hiệu lực (chỉ mục riêng phần
/// `supplier_bills_mot_hieu_luc_moi_don` trong migration 0.16.1).
model SupplierBill {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  number          String    @db.VarChar(30)
  supplierId      String    @map("supplier_id") @db.Uuid
  purchaseOrderId String?   @map("purchase_order_id") @db.Uuid
  ownerId         String    @map("owner_id") @db.Uuid
  /// DRAFT | RECORDED | CANCELLED — "đã trả đủ hay chưa" TÍNH từ phân bổ, không lưu.
  status          String    @default("DRAFT") @db.VarChar(20)
  /// Số hóa đơn do nhà cung cấp phát hành — để đối chiếu và tra thuế.
  supplierDocNo   String?   @map("supplier_doc_no") @db.VarChar(100)
  billDate        DateTime? @map("bill_date") @db.Date
  dueDate         DateTime? @map("due_date") @db.Date
  notes           String?   @db.Text
  subtotal        Decimal   @default(0) @db.Decimal(18, 2)
  discountTotal   Decimal   @default(0) @map("discount_total") @db.Decimal(18, 2)
  vatTotal        Decimal   @default(0) @map("vat_total") @db.Decimal(18, 2)
  total           Decimal   @default(0) @db.Decimal(18, 2)
  recordedAt      DateTime? @map("recorded_at") @db.Timestamptz(6)
  recordedBy      String?   @map("recorded_by") @db.Uuid
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason    String?   @map("cancel_reason") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?   @map("created_by") @db.Uuid
  updatedBy       String?   @map("updated_by") @db.Uuid

  tenant            Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier          Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder     PurchaseOrder?              @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  owner             User                        @relation("HoaDonMuaPhuTrach", fields: [ownerId], references: [id], onDelete: Restrict)
  items             SupplierBillItem[]
  allocations       SupplierPaymentAllocation[]
  returnAllocations PurchaseReturnAllocation[]

  @@unique([tenantId, number])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, supplierId])
  @@map("supplier_bills")
}

/// Dòng hóa đơn nhà cung cấp — chép từ dòng đơn mua lúc lập, giữ liên kết để truy ngược.
model SupplierBillItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  billId      String   @map("bill_id") @db.Uuid
  lineNo      Int      @map("line_no")
  orderItemId String?  @map("order_item_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  sku         String?  @db.VarChar(64)
  name        String   @db.VarChar(500)
  quantity    Decimal  @default(1) @db.Decimal(18, 3)
  unit        String?  @db.VarChar(50)
  unitPrice   Decimal  @default(0) @map("unit_price") @db.Decimal(18, 2)
  discountPct Decimal  @default(0) @map("discount_pct") @db.Decimal(7, 4)
  vatRate     Decimal  @default(10) @map("vat_rate") @db.Decimal(7, 4)
  lineTotal   Decimal  @default(0) @map("line_total") @db.Decimal(18, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bill      SupplierBill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  orderItem PurchaseOrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  product   Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([billId, lineNo])
  @@index([tenantId, productId])
  @@map("supplier_bill_items")
}

/// Phiếu chi trả nhà cung cấp. Số PC-2026-0001. Một phiếu trừ được nhiều hóa đơn.
model SupplierPayment {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  number       String    @db.VarChar(30)
  supplierId   String    @map("supplier_id") @db.Uuid
  /// tien-mat | chuyen-khoan | the | bu-tru
  method       String    @db.VarChar(20)
  amount       Decimal   @db.Decimal(18, 2)
  paidAt       DateTime  @map("paid_at") @db.Date
  reference    String?   @db.VarChar(255)
  note         String?   @db.Text
  /// hoat-dong | huy — hủy thì giữ lại bản ghi kèm lý do, không xóa.
  status       String    @default("hoat-dong") @db.VarChar(20)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason String?   @map("cancel_reason") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid

  tenant      Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier    Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  allocations SupplierPaymentAllocation[]

  @@unique([tenantId, number])
  @@index([tenantId, supplierId, paidAt])
  @@map("supplier_payments")
}

/// Phân bổ một phiếu chi cho một hóa đơn nhà cung cấp. Tổng phân bổ = số tiền đã chi.
model SupplierPaymentAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  billId    String   @map("bill_id") @db.Uuid
  amount    Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill    SupplierBill    @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@unique([paymentId, billId])
  @@index([tenantId, billId])
  @@map("supplier_payment_allocations")
}

// ---------------------------------------------------------------------------
// Trả hàng và đổi máy.
// Hai chiều đối xứng: khách trả cho mình (`sales_returns`) và mình trả nhà cung cấp
// (`purchase_returns`). Cả hai đi qua ĐÚNG hàm ghi sổ kho của bán hàng và mua hàng,
// rồi chốt tiền bằng cách **giảm trừ** hóa đơn — không lưu công nợ thành cột (QĐ-09).
// ---------------------------------------------------------------------------

/// Phiếu khách trả hàng, hoặc đổi máy trong bảo hành. Số TH-2026-0001.
model SalesReturn {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  number       String    @db.VarChar(30)
  customerId   String    @map("customer_id") @db.Uuid
  salesOrderId String?   @map("sales_order_id") @db.Uuid
  deliveryId   String?   @map("delivery_id") @db.Uuid
  /// Kho nhận hàng trả về; với đổi máy cũng là kho xuất hàng thay thế.
  warehouseId  String    @map("warehouse_id") @db.Uuid
  ownerId      String    @map("owner_id") @db.Uuid
  /// tra-hang | doi-may — đổi máy không phát sinh tiền (TH-08).
  kind         String    @default("tra-hang") @db.VarChar(20)
  /// DRAFT | CONFIRMED (hàng đã vào kho) | SETTLED (tiền đã chốt) | CANCELLED
  status       String    @default("DRAFT") @db.VarChar(20)
  returnDate   DateTime  @map("return_date") @db.Date
  reason       String    @db.Text
  notes        String?   @db.Text
  subtotal     Decimal   @default(0) @db.Decimal(18, 2)
  vatTotal     Decimal   @default(0) @map("vat_total") @db.Decimal(18, 2)
  total        Decimal   @default(0) @db.Decimal(18, 2)
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz(6)
  confirmedBy  String?   @map("confirmed_by") @db.Uuid
  settledAt    DateTime? @map("settled_at") @db.Timestamptz(6)
  settledBy    String?   @map("settled_by") @db.Uuid
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason String?   @map("cancel_reason") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid

  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrder  SalesOrder?             @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  delivery    Delivery?               @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  warehouse   Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  owner       User                    @relation("TraHangBanPhuTrach", fields: [ownerId], references: [id], onDelete: Restrict)
  items       SalesReturnItem[]
  allocations SalesReturnAllocation[]

  @@unique([tenantId, number])
  @@index([tenantId, status, returnDate])
  @@index([tenantId, customerId])
  @@map("sales_returns")
}

/// Dòng hàng khách trả. Giữ liên kết tới dòng đơn gốc để đối chiếu đã bán bao nhiêu.
model SalesReturnItem {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  returnId             String   @map("return_id") @db.Uuid
  lineNo               Int      @map("line_no")
  orderItemId          String?  @map("order_item_id") @db.Uuid
  productId            String?  @map("product_id") @db.Uuid
  sku                  String?  @db.VarChar(64)
  name                 String   @db.VarChar(500)
  quantity             Decimal  @default(1) @db.Decimal(18, 3)
  unit                 String?  @db.VarChar(50)
  unitPrice            Decimal  @default(0) @map("unit_price") @db.Decimal(18, 2)
  vatRate              Decimal  @default(10) @map("vat_rate") @db.Decimal(7, 4)
  lineTotal            Decimal  @default(0) @map("line_total") @db.Decimal(18, 2)
  /// con-tot | loi — hàng lỗi mặc định KHÔNG nhập lại kho đang bán (TH-06).
  condition            String   @default("con-tot") @db.VarChar(20)
  /// Có cộng lại vào tồn kho hay không. Hàng lỗi mà vẫn nhập lại thì phải ghi chú.
  restock              Boolean  @default(true)
  /// Đổi máy: mặt hàng giao thay thế. Trả hàng thường thì để trống.
  replacementProductId String?  @map("replacement_product_id") @db.Uuid
  note                 String?  @db.Text
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesReturn        SalesReturn     @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem          SalesOrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  product            Product?        @relation("TraHangBanSanPham", fields: [productId], references: [id], onDelete: SetNull)
  replacementProduct Product?        @relation("TraHangBanHangThayThe", fields: [replacementProductId], references: [id], onDelete: SetNull)
  serials            SerialNumber[]

  @@unique([returnId, lineNo])
  @@index([tenantId, productId])
  @@index([tenantId, orderItemId])
  @@map("sales_return_items")
}

/// Giảm trừ một phiếu trả hàng vào một hóa đơn bán ra. Tổng giảm trừ ≤ giá trị phiếu.
model SalesReturnAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  returnId  String   @map("return_id") @db.Uuid
  invoiceId String   @map("invoice_id") @db.Uuid
  amount    Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesReturn SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  invoice     Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([returnId, invoiceId])
  @@index([tenantId, invoiceId])
  @@map("sales_return_allocations")
}

/// Phiếu trả hàng cho nhà cung cấp. Số TM-2026-0001.
model PurchaseReturn {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  number          String    @db.VarChar(30)
  supplierId      String    @map("supplier_id") @db.Uuid
  purchaseOrderId String?   @map("purchase_order_id") @db.Uuid
  /// Kho xuất hàng trả đi.
  warehouseId     String    @map("warehouse_id") @db.Uuid
  ownerId         String    @map("owner_id") @db.Uuid
  /// DRAFT | CONFIRMED (hàng đã ra khỏi kho) | SETTLED (đã giảm trừ công nợ) | CANCELLED
  status          String    @default("DRAFT") @db.VarChar(20)
  returnDate      DateTime  @map("return_date") @db.Date
  reason          String    @db.Text
  notes           String?   @db.Text
  subtotal        Decimal   @default(0) @db.Decimal(18, 2)
  vatTotal        Decimal   @default(0) @map("vat_total") @db.Decimal(18, 2)
  total           Decimal   @default(0) @db.Decimal(18, 2)
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(6)
  confirmedBy     String?   @map("confirmed_by") @db.Uuid
  settledAt       DateTime? @map("settled_at") @db.Timestamptz(6)
  settledBy       String?   @map("settled_by") @db.Uuid
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason    String?   @map("cancel_reason") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?   @map("created_by") @db.Uuid
  updatedBy       String?   @map("updated_by") @db.Uuid

  tenant        Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier      Supplier                   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?             @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  warehouse     Warehouse                  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  owner         User                       @relation("TraHangMuaPhuTrach", fields: [ownerId], references: [id], onDelete: Restrict)
  items         PurchaseReturnItem[]
  allocations   PurchaseReturnAllocation[]

  @@unique([tenantId, number])
  @@index([tenantId, status, returnDate])
  @@index([tenantId, supplierId])
  @@map("purchase_returns")
}

/// Dòng hàng trả nhà cung cấp. Giữ liên kết tới dòng đơn mua để đối chiếu đã nhận bao nhiêu.
model PurchaseReturnItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  returnId    String   @map("return_id") @db.Uuid
  lineNo      Int      @map("line_no")
  orderItemId String?  @map("order_item_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  sku         String?  @db.VarChar(64)
  name        String   @db.VarChar(500)
  quantity    Decimal  @default(1) @db.Decimal(18, 3)
  unit        String?  @db.VarChar(50)
  unitPrice   Decimal  @default(0) @map("unit_price") @db.Decimal(18, 2)
  vatRate     Decimal  @default(10) @map("vat_rate") @db.Decimal(7, 4)
  lineTotal   Decimal  @default(0) @map("line_total") @db.Decimal(18, 2)
  note        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseReturn PurchaseReturn     @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem      PurchaseOrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  product        Product?           @relation("TraHangMuaSanPham", fields: [productId], references: [id], onDelete: SetNull)

  @@unique([returnId, lineNo])
  @@index([tenantId, productId])
  @@index([tenantId, orderItemId])
  @@map("purchase_return_items")
}

/// Giảm trừ một phiếu trả hàng mua vào một hóa đơn nhà cung cấp.
model PurchaseReturnAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  returnId  String   @map("return_id") @db.Uuid
  billId    String   @map("bill_id") @db.Uuid
  amount    Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  bill           SupplierBill   @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@unique([returnId, billId])
  @@index([tenantId, billId])
  @@map("purchase_return_allocations")
}

// ---------------------------------------------------------------------------
// Chuyển kho nội bộ.
// Hai bước vì hàng đi xe giữa hai kho: xuất khỏi kho nguồn trước, nhận vào kho
// đích sau. Giữa hai bước hàng KHÔNG nằm ở kho nào — đó là sự thật, và màn hình
// nói thẳng "đang trên đường" thay vì cho tồn nhảy tức thì từ kho này sang kho kia.
// ---------------------------------------------------------------------------

/// Phiếu chuyển kho nội bộ. Số CK-2026-0001.
model StockTransfer {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  number          String    @db.VarChar(30)
  fromWarehouseId String    @map("from_warehouse_id") @db.Uuid
  toWarehouseId   String    @map("to_warehouse_id") @db.Uuid
  ownerId         String    @map("owner_id") @db.Uuid
  /// DRAFT | IN_TRANSIT (đã xuất, đang trên đường) | RECEIVED (đã nhận đủ hoặc nhận kèm chênh lệch) | CANCELLED
  status          String    @default("DRAFT") @db.VarChar(20)
  transferDate    DateTime  @map("transfer_date") @db.Date
  reason          String    @db.Text
  notes           String?   @db.Text
  shippedAt       DateTime? @map("shipped_at") @db.Timestamptz(6)
  shippedBy       String?   @map("shipped_by") @db.Uuid
  receivedAt      DateTime? @map("received_at") @db.Timestamptz(6)
  receivedBy      String?   @map("received_by") @db.Uuid
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason    String?   @map("cancel_reason") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?   @map("created_by") @db.Uuid
  updatedBy       String?   @map("updated_by") @db.Uuid

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse           @relation("ChuyenKhoNguon", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse           @relation("ChuyenKhoDich", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  owner         User                @relation("ChuyenKhoPhuTrach", fields: [ownerId], references: [id], onDelete: Restrict)
  items         StockTransferItem[]

  @@unique([tenantId, number])
  @@index([tenantId, status, transferDate])
  @@index([tenantId, fromWarehouseId])
  @@map("stock_transfers")
}

/// Dòng hàng chuyển kho. `receivedQty` nhỏ hơn `quantity` nghĩa là thiếu dọc đường — phải ghi lý do.
model StockTransferItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  transferId  String   @map("transfer_id") @db.Uuid
  lineNo      Int      @map("line_no")
  productId   String   @map("product_id") @db.Uuid
  sku         String?  @db.VarChar(64)
  name        String   @db.VarChar(500)
  quantity    Decimal  @db.Decimal(18, 3)
  receivedQty Decimal  @default(0) @map("received_qty") @db.Decimal(18, 3)
  unit        String?  @db.VarChar(50)
  note        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transfer StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product        @relation("ChuyenKhoSanPham", fields: [productId], references: [id], onDelete: Restrict)
  serials  SerialNumber[]

  @@unique([transferId, lineNo])
  @@index([tenantId, productId])
  @@map("stock_transfer_items")
}

// ---------------------------------------------------------------------------
// Tệp đính kèm cho chứng từ.
// Nội dung tệp nằm TRÊN ĐĨA (thư mục `data/dinh-kem`, gắn thành volume Docker);
// bảng này chỉ giữ thông tin về tệp. Để nội dung trong CSDL thì mỗi lần sao lưu
// phải kéo theo hàng gigabyte ảnh chụp hóa đơn, và pg_dump chậm dần theo thời gian.
// ---------------------------------------------------------------------------

/// Một tệp đính kèm vào một chứng từ. Xóa là xóa mềm — không bao giờ mất dấu vết.
model Attachment {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  /// supplier_bill | sales_return | purchase_return | stock_transfer | sales_order | support_ticket | task
  objectType   String    @map("object_type") @db.VarChar(40)
  objectId     String    @map("object_id") @db.Uuid
  /// Tên tệp người dùng thấy. **Không** dùng để đặt tên tệp trên đĩa.
  fileName     String    @map("file_name") @db.VarChar(255)
  /// Đường dẫn tương đối trong thư mục đính kèm, do hệ thống sinh (không lấy từ người dùng).
  storedPath   String    @map("stored_path") @db.VarChar(500)
  /// Kiểu tệp do hệ thống xác định, không tin `Content-Type` trình duyệt gửi lên.
  mimeType     String    @map("mime_type") @db.VarChar(100)
  sizeBytes    Int       @map("size_bytes")
  /// Để đối chiếu tệp trên đĩa có đúng tệp đã tải lên không, và để nhận ra tệp trùng.
  sha256       String    @db.VarChar(64)
  note         String?   @db.Text
  uploadedAt   DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  uploadedBy   String    @map("uploaded_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy    String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason") @db.Text

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploader User   @relation("TepDinhKemNguoiTai", fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([tenantId, objectType, objectId])
  @@index([tenantId, sha256])
  @@map("attachments")
}

// ---------------------------------------------------------------------------
// 0.16.0 — Khách hàng nâng cao: hành trình, nhóm khách, bộ lọc đã lưu.
// Luật: BUSINESS_RULES.md mục 21 (KHN).
// ---------------------------------------------------------------------------

/// Trạng thái hành trình khách hàng — danh mục theo doanh nghiệp. KHÁC `customers.status`.
model CustomerJourneyStage {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  code          String   @db.VarChar(50)
  name          String   @db.VarChar(100)
  /// "#RRGGBB"
  color         String   @db.VarChar(7)
  sortOrder     Int      @default(0) @map("sort_order")
  /// mo | thanh-cong | that-bai — `that-bai` nằm ngoài phễu (khách bỏ, sai số, trùng…)
  kind          String   @default("mo") @db.VarChar(20)
  /// Khách đứng quá số ngày này ở trạng thái thì nhắc người phụ trách. NULL = không nhắc.
  staleDays     Int?     @map("stale_days")
  /// Mốc tự chuyển bước (mã trong src/modules/hanh-trinh/moc.ts). NULL = chỉ đổi tay.
  autoMilestone String?  @map("auto_milestone") @db.VarChar(30)
  status        String   @default("hoat-dong") @db.VarChar(30)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy     String?  @map("created_by") @db.Uuid
  updatedBy     String?  @map("updated_by") @db.Uuid

  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customers   Customer[]
  historyFrom CustomerJourneyHistory[] @relation("HanhTrinhTu")
  historyTo   CustomerJourneyHistory[] @relation("HanhTrinhSang")

  @@unique([tenantId, code])
  @@unique([tenantId, autoMilestone])
  @@index([tenantId, sortOrder])
  @@map("customer_journey_stages")
}

/// Lịch sử đổi trạng thái hành trình. **Chỉ ghi thêm** (trigger chan_sua_xoa).
model CustomerJourneyHistory {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  fromStageId String?  @map("from_stage_id") @db.Uuid
  toStageId   String?  @map("to_stage_id") @db.Uuid
  /// true = hệ thống tự chuyển theo mốc nghiệp vụ; false = người dùng đổi tay.
  isAuto      Boolean  @default(false) @map("is_auto")
  milestone   String?  @db.VarChar(30)
  note        String?  @db.Text
  /// Người đổi (hoặc người có thao tác gây ra lần tự chuyển).
  changedBy   String?  @map("changed_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  fromStage CustomerJourneyStage? @relation("HanhTrinhTu", fields: [fromStageId], references: [id], onDelete: Restrict)
  toStage   CustomerJourneyStage? @relation("HanhTrinhSang", fields: [toStageId], references: [id], onDelete: Restrict)

  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, createdAt])
  @@map("customer_journey_history")
}

/// Nhóm khách hàng (nhiều–nhiều với khách).
model CustomerGroup {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(100)
  color       String   @db.VarChar(7)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  status      String   @default("hoat-dong") @db.VarChar(30)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid

  tenant  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members CustomerGroupMember[]

  @@index([tenantId, status])
  @@map("customer_groups")
}

/// Bảng nối khách ↔ nhóm. Là bảng nối nên gỡ thành viên được xóa dòng.
model CustomerGroupMember {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?  @map("created_by") @db.Uuid

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group    CustomerGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([groupId, customerId])
  @@index([tenantId, customerId])
  @@map("customer_group_members")
}

/// Bộ lọc đã lưu của một màn hình danh sách: cá nhân hoặc dùng chung.
model SavedView {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  /// khach-hang (CHECK)
  screen    String   @db.VarChar(30)
  name      String   @db.VarChar(100)
  isShared  Boolean  @default(false) @map("is_shared")
  /// Tham số lọc dạng URL. Đọc ra luôn kiểm lại bằng lược đồ — không tin dữ liệu lưu.
  filters   Json
  status    String   @default("hoat-dong") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner  User   @relation("BoLocCua", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([tenantId, screen, ownerId])
  @@map("saved_views")
}

/// Tùy chọn danh sách theo người dùng: cột hiển thị + bộ lọc mặc định.
model UserListPreference {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  screen        String   @db.VarChar(30)
  /// Mảng mã cột. Đọc ra lọc theo danh mục cột thật.
  columns       Json?
  defaultViewId String?  @map("default_view_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy     String?  @map("created_by") @db.Uuid
  updatedBy     String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("TuyChonDanhSachCua", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, screen])
  @@map("user_list_preferences")
}

// ===========================================================================
// Marketing và thu lead (0.16.0)
//
// Chiến dịch + chi phí → chỉ số CPL/ROAS; một cửa nhận lead `nhanLead()` cho form công
// khai, landing page, webhook và nhập tay; phân khúc; landing page dựng từ khối an toàn.
// Luật nghiệp vụ: BUSINESS_RULES.md mục 22 (MK). Ràng buộc CHECK viết tay trong migration.
// ===========================================================================

/// Chiến dịch marketing. Mã CD-2026-0001; utm_campaign duy nhất để gắn lead theo đường dẫn.
model MarketingCampaign {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  code           String    @db.VarChar(30)
  name           String    @db.VarChar(255)
  /// facebook | google | zalo | tiktok | website | email | su-kien | offline | khac
  channel        String    @db.VarChar(30)
  /// Giá trị utm_campaign người làm quảng cáo đặt trên đường dẫn. Duy nhất trong doanh nghiệp.
  utmCampaign    String?   @map("utm_campaign") @db.VarChar(120)
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  budget         Decimal   @default(0) @db.Decimal(18, 2)
  targetLeads    Int?      @map("target_leads")
  ownerId        String    @map("owner_id") @db.Uuid
  /// ke-hoach | cho-duyet | dang-chay | tam-dung | ket-thuc | huy
  status         String    @default("ke-hoach") @db.VarChar(20)
  /// Ngân sách đã được duyệt (MK-03). Tăng ngân sách quá mức này thì phải duyệt lại.
  approvedBudget Decimal?  @map("approved_budget") @db.Decimal(18, 2)
  approvedBy     String?   @map("approved_by") @db.Uuid
  approvedAt     DateTime? @map("approved_at") @db.Timestamptz(6)
  cancelReason   String?   @map("cancel_reason") @db.Text
  note           String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid

  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner          User                     @relation("ChienDichPhuTrach", fields: [ownerId], references: [id], onDelete: Restrict)
  costs          MarketingCost[]
  leads          Lead[]
  customers      Customer[]
  opportunities  Opportunity[]
  forms          MarketingForm[]
  webhookSources MarketingWebhookSource[]
  captures       LeadCapture[]
  landingPages   LandingPage[]

  @@unique([tenantId, code])
  @@unique([tenantId, utmCampaign])
  @@index([tenantId, status])
  @@index([tenantId, ownerId])
  @@map("marketing_campaigns")
}

/// Chi phí thực tế của chiến dịch, theo ngày / theo khoản. Không xóa — hủy kèm lý do (MK-04).
model MarketingCost {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  campaignId   String    @map("campaign_id") @db.Uuid
  costDate     DateTime  @map("cost_date") @db.Date
  amount       Decimal   @db.Decimal(18, 2)
  /// quang-cao | noi-dung | in-an | su-kien | qua-tang | khac
  category     String    @default("quang-cao") @db.VarChar(30)
  note         String?   @db.Text
  /// hoat-dong | huy
  status       String    @default("hoat-dong") @db.VarChar(20)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy  String?   @map("cancelled_by") @db.Uuid
  cancelReason String?   @map("cancel_reason") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@index([tenantId, campaignId, costDate])
  @@map("marketing_costs")
}

/// Danh sách sale nhận lead theo vòng tròn (MK-08). Thứ tự theo sort_order rồi theo id.
model MarketingLeadAssignee {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  sortOrder Int      @default(0) @map("sort_order")
  /// hoat-dong | tam-dung
  status    String   @default("hoat-dong") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("NhanLeadVongTron", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@map("marketing_lead_assignees")
}

/// Form đăng ký công khai /f/<mã doanh nghiệp>/<slug>. Trường chỉ lấy từ danh mục an toàn.
model MarketingForm {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  slug           String   @db.VarChar(60)
  name           String   @db.VarChar(255)
  title          String   @db.VarChar(255)
  intro          String?  @db.Text
  /// [{ khoa, nhan, batBuoc }] — khoa thuộc danh mục TRUONG_FORM (src/modules/marketing/hang-so.ts).
  fields         Json
  buttonText     String?  @map("button_text") @db.VarChar(60)
  successMessage String?  @map("success_message") @db.Text
  /// Câu hỏi đồng ý nhận tin. Trống = form không hỏi, lead không được coi là đã đồng ý.
  consentText    String?  @map("consent_text") @db.Text
  campaignId     String?  @map("campaign_id") @db.Uuid
  /// Mã dữ liệu gốc nguon_lead gán cho lead từ form này.
  source         String?  @db.VarChar(50)
  ownerId        String   @map("owner_id") @db.Uuid
  viewCount      Int      @default(0) @map("view_count")
  /// hoat-dong | tat
  status         String   @default("hoat-dong") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign     MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  owner        User               @relation("FormPhuTrach", fields: [ownerId], references: [id], onDelete: Restrict)
  captures     LeadCapture[]
  landingPages LandingPage[]

  @@unique([tenantId, slug])
  @@map("marketing_forms")
}

/// Nguồn webhook nhận lead (Facebook Lead Ads qua Zapier/Make, Zalo, website khác).
/// Khóa bí mật chỉ lưu bản băm SHA-256, hiện một lần lúc tạo / đổi khóa (MK-12).
model MarketingWebhookSource {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  code           String    @db.VarChar(60)
  name           String    @db.VarChar(255)
  keyHash        String    @map("key_hash") @db.VarChar(64)
  /// 4 ký tự cuối của khóa — để người dùng nhận ra khóa nào đang dùng.
  keyHint        String    @map("key_hint") @db.VarChar(8)
  campaignId     String?   @map("campaign_id") @db.Uuid
  source         String?   @db.VarChar(50)
  ownerId        String    @map("owner_id") @db.Uuid
  /// hoat-dong | thu-hoi
  status         String    @default("hoat-dong") @db.VarChar(20)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy      String?   @map("revoked_by") @db.Uuid
  lastReceivedAt DateTime? @map("last_received_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  owner    User               @relation("NguonWebhookPhuTrach", fields: [ownerId], references: [id], onDelete: Restrict)
  captures LeadCapture[]

  @@unique([tenantId, code])
  @@map("marketing_webhook_sources")
}

/// Nhật ký mỗi lần nhận lead — mọi kênh, cả lần bị từ chối. **Chỉ ghi thêm** (trigger).
model LeadCapture {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  /// form | landing | webhook | nhap-tay
  channel         String   @db.VarChar(20)
  /// tao-moi | ghi-them | tu-choi | spam
  result          String   @db.VarChar(20)
  reason          String?  @db.Text
  leadId          String?  @map("lead_id") @db.Uuid
  campaignId      String?  @map("campaign_id") @db.Uuid
  formId          String?  @map("form_id") @db.Uuid
  webhookSourceId String?  @map("webhook_source_id") @db.Uuid
  landingPageId   String?  @map("landing_page_id") @db.Uuid
  /// A | B — biến thể landing page người gửi đã xem.
  landingVariant  String?  @map("landing_variant") @db.VarChar(1)
  assignedTo      String?  @map("assigned_to") @db.Uuid
  utmSource       String?  @map("utm_source") @db.VarChar(120)
  utmMedium       String?  @map("utm_medium") @db.VarChar(120)
  utmCampaign     String?  @map("utm_campaign") @db.VarChar(120)
  utmContent      String?  @map("utm_content") @db.VarChar(120)
  utmTerm         String?  @map("utm_term") @db.VarChar(120)
  /// Dữ liệu đã cắt độ dài, giữ để đối chiếu. Không giữ khóa bí mật.
  payload         Json?
  ipAddress       String?  @map("ip_address") @db.VarChar(45)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?  @map("created_by") @db.Uuid

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead          Lead?                   @relation(fields: [leadId], references: [id], onDelete: Restrict)
  campaign      MarketingCampaign?      @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  form          MarketingForm?          @relation(fields: [formId], references: [id], onDelete: Restrict)
  webhookSource MarketingWebhookSource? @relation(fields: [webhookSourceId], references: [id], onDelete: Restrict)
  landingPage   LandingPage?            @relation(fields: [landingPageId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, campaignId, createdAt])
  @@index([tenantId, formId])
  @@index([tenantId, webhookSourceId, createdAt(sort: Desc)])
  @@index([tenantId, landingPageId])
  @@map("lead_captures")
}

/// Phân khúc lead / liên hệ theo điều kiện. Điều kiện là JSON kiểm bằng Zod theo danh mục trường.
model MarketingSegment {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String   @db.VarChar(255)
  /// lead | lien-he
  target     String   @db.VarChar(20)
  conditions Json
  note       String?  @db.Text
  ownerId    String   @map("owner_id") @db.Uuid
  /// hoat-dong | luu-tru
  status     String   @default("hoat-dong") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy  String?  @map("created_by") @db.Uuid
  updatedBy  String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner  User   @relation("PhanKhucPhuTrach", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@map("marketing_segments")
}

/// Landing page công khai /lp/<mã doanh nghiệp>/<slug>, dựng từ khối khai báo bằng mã (MK-16).
model LandingPage {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  slug        String    @db.VarChar(60)
  name        String    @db.VarChar(255)
  /// Tiêu đề thẻ <title> và chia sẻ mạng xã hội.
  title       String    @db.VarChar(255)
  description String?   @db.VarChar(500)
  /// Danh sách khối (biến thể A). Kiểm bằng Zod ở src/modules/marketing/khoi-landing.ts.
  blocks      Json
  /// Biến thể B cho thử nghiệm A/B. Null = không thử.
  blocksB     Json?     @map("blocks_b")
  formId      String?   @map("form_id") @db.Uuid
  campaignId  String?   @map("campaign_id") @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  /// nhap | xuat-ban | an
  status      String    @default("nhap") @db.VarChar(20)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  viewsA      Int       @default(0) @map("views_a")
  viewsB      Int       @default(0) @map("views_b")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  form     MarketingForm?     @relation(fields: [formId], references: [id], onDelete: SetNull)
  campaign MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  owner    User               @relation("LandingPhuTrach", fields: [ownerId], references: [id], onDelete: Restrict)
  captures LeadCapture[]

  @@unique([tenantId, slug])
  @@map("landing_pages")
}

// ---------------------------------------------------------------------------
// Email marketing (0.16.0): kết nối SMTP, mẫu thư dựng bằng khối an toàn, chiến dịch
// gửi qua hàng đợi trong worker, huỷ nhận tin một chạm, theo dõi mở / bấm.
// Luật: BUSINESS_RULES.md mục 23 (EM). Kiến trúc: ARCHITECTURE.md mục 7q.
// ---------------------------------------------------------------------------

/// Kết nối hộp thư gửi (SMTP) — một dòng mỗi doanh nghiệp. Mật khẩu **mã hóa**, không bao giờ trả ra API.
model EmailSetting {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  host                String    @db.VarChar(255)
  port                Int
  /// tls (cổng 465) | starttls (cổng 587) | none (chỉ cho máy chủ nội bộ)
  security            String    @db.VarChar(10)
  username            String?   @db.VarChar(255)
  /// AES-256-GCM bằng APP_ENC_KEY, gắn ngữ cảnh doanh nghiệp. null = máy chủ không đòi đăng nhập.
  passwordEnc         String?   @map("password_enc") @db.Text
  fromName            String    @map("from_name") @db.VarChar(255)
  fromEmail           String    @map("from_email") @db.VarChar(255)
  replyTo             String?   @map("reply_to") @db.VarChar(255)
  /// Bật điểm ảnh đếm lượt mở và chuyển hướng đếm lượt bấm.
  trackingEnabled     Boolean   @default(false) @map("tracking_enabled")
  lastTestAt          DateTime? @map("last_test_at") @db.Timestamptz(6)
  lastTestOk          Boolean?  @map("last_test_ok")
  lastTestError       String?   @map("last_test_error") @db.Text
  /// 0.18.0 — kênh gửi: smtp (hộp thư SMTP bất kỳ) | ses (Amazon SES qua cổng SMTP của vùng).
  provider            String    @default("smtp") @db.VarChar(10)
  /// Vùng SES, ví dụ ap-southeast-1. Bắt buộc khi provider = ses.
  sesRegion           String?   @map("ses_region") @db.VarChar(30)
  /// Configuration set của SES — đi vào tiêu đề X-SES-CONFIGURATION-SET để SES đẩy sự kiện qua SNS.
  sesConfigurationSet String?   @map("ses_configuration_set") @db.VarChar(64)
  /// Tên miền gửi thư marketing (vd tin.itwonline.com). provider = ses thì địa chỉ gửi phải thuộc tên miền này.
  sendingDomain       String?   @map("sending_domain") @db.VarChar(255)
  /// Tên miền MAIL FROM riêng (vd bounce.tin.itwonline.com). Trống = bounce.<tên miền gửi>.
  mailFromDomain      String?   @map("mail_from_domain") @db.VarChar(255)
  /// 3 mã DKIM (Easy DKIM) quản trị dán từ bảng điều khiển SES.
  dkimTokens          Json      @default("[]") @map("dkim_tokens")
  /// Hộp thư nhận báo cáo DMARC (rua=mailto:…).
  dmarcRua            String?   @map("dmarc_rua") @db.VarChar(255)
  /// ARN của chủ đề SNS nhận sự kiện SES — chỉ nhận thông điệp đúng chủ đề này.
  sesTopicArn         String?   @map("ses_topic_arn") @db.VarChar(300)
  /// SHA-256 của mã webhook SES (mã hiện một lần, máy chủ chỉ giữ băm).
  sesWebhookHash      String?   @map("ses_webhook_hash") @db.VarChar(64)
  sesWebhookHint      String?   @map("ses_webhook_hint") @db.VarChar(8)
  sesWebhookRotatedAt DateTime? @map("ses_webhook_rotated_at") @db.Timestamptz(6)
  /// Lúc xác nhận đăng ký SNS (SubscriptionConfirmation) thành công.
  sesSubscribedAt     DateTime? @map("ses_subscribed_at") @db.Timestamptz(6)
  sesLastEventAt      DateTime? @map("ses_last_event_at") @db.Timestamptz(6)
  /// Kết quả lần kiểm tra DNS gần nhất (danh sách bản ghi + trạng thái).
  dnsCheck            Json?     @map("dns_check")
  dnsCheckedAt        DateTime? @map("dns_checked_at") @db.Timestamptz(6)
  status              String    @default("hoat-dong") @db.VarChar(30)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy           String?   @map("created_by") @db.Uuid
  updatedBy           String?   @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId])
  @@map("email_settings")
}

/// Mẫu email: tiêu đề + danh sách khối an toàn (JSON đã kiểm bằng lược đồ). Không nhận HTML tự do.
model EmailTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(255)
  subject   String   @db.VarChar(255)
  blocks    Json     @default("[]")
  /// hoat-dong | luu-tru
  status    String   @default("hoat-dong") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns EmailCampaign[]

  @@index([tenantId, status])
  @@map("email_templates")
}

/// Chiến dịch email. Số EM-2026-0001. Nội dung chép từ mẫu lúc lập, **đóng băng** lúc duyệt.
model EmailCampaign {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  code               String    @db.VarChar(30)
  name               String    @db.VarChar(255)
  templateId         String?   @map("template_id") @db.Uuid
  subject            String    @db.VarChar(255)
  blocks             Json      @default("[]")
  /// Mã nguồn người nhận (src/modules/email/nguon-nguoi-nhan.ts) + tham số lọc.
  sourceCode         String    @map("source_code") @db.VarChar(50)
  sourceParams       Json      @default("{}") @map("source_params")
  /// DRAFT | PENDING_APPROVAL | SENDING | PAUSED | COMPLETED | CANCELLED
  status             String    @default("DRAFT") @db.VarChar(20)
  submittedAt        DateTime? @map("submitted_at") @db.Timestamptz(6)
  submittedBy        String?   @map("submitted_by") @db.Uuid
  approvedAt         DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedBy         String?   @map("approved_by") @db.Uuid
  pausedAt           DateTime? @map("paused_at") @db.Timestamptz(6)
  /// Vì sao đang tạm dừng: người bấm, hoặc máy tự dừng khi hộp thư gửi báo lỗi kết nối / đăng nhập.
  pauseReason        String?   @map("pause_reason") @db.Text
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy        String?   @map("cancelled_by") @db.Uuid
  cancelReason       String?   @map("cancel_reason") @db.Text
  /// Chụp lại lúc duyệt: có theo dõi mở/bấm hay không (đổi Cấu hình sau không đổi thư đã gửi).
  trackingEnabled    Boolean   @default(false) @map("tracking_enabled")
  /// Chụp lại lúc duyệt: bao nhiêu người bị loại vì lý do gì (cả những người không có email, không thành dòng người nhận).
  recipientSummary   Json      @default("{}") @map("recipient_summary")
  /// 0.18.0 — vì sao tạm dừng: tay | ket-noi | ty-le-hong | ty-le-bao-rac | khac.
  pauseCode          String?   @map("pause_code") @db.VarChar(30)
  /// Mốc tính tỷ lệ hỏng / báo rác (chụp lúc tiếp tục sau khi máy tự dừng vì tỷ lệ): chỉ xét thư gửi sau mốc.
  rateBaseSample     Int       @default(0) @map("rate_base_sample")
  rateBaseBounced    Int       @default(0) @map("rate_base_bounced")
  rateBaseComplained Int       @default(0) @map("rate_base_complained")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          String?   @map("created_by") @db.Uuid
  updatedBy          String?   @map("updated_by") @db.Uuid

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template   EmailTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients EmailRecipient[]
  events     EmailEvent[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("email_campaigns")
}

/// Một người nhận của một chiến dịch. Khóa duy nhất (chiến dịch, email) chống gửi trùng.
model EmailRecipient {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  campaignId     String    @map("campaign_id") @db.Uuid
  /// Email đã chuẩn hóa chữ thường.
  email          String    @db.VarChar(255)
  name           String    @db.VarChar(255)
  companyName    String?   @map("company_name") @db.VarChar(255)
  /// lead | contact
  recipientType  String    @map("recipient_type") @db.VarChar(20)
  leadId         String?   @map("lead_id") @db.Uuid
  contactId      String?   @map("contact_id") @db.Uuid
  customerId     String?   @map("customer_id") @db.Uuid
  /// QUEUED | SENDING | SENT | FAILED | SKIPPED
  status         String    @default("QUEUED") @db.VarChar(20)
  /// Lý do lỗi / bị loại — bắt buộc khi FAILED hoặc SKIPPED.
  reason         String?   @db.Text
  attemptAt      DateTime? @map("attempt_at") @db.Timestamptz(6)
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(6)
  messageId      String?   @map("message_id") @db.VarChar(255)
  openedAt       DateTime? @map("opened_at") @db.Timestamptz(6)
  openCount      Int       @default(0) @map("open_count")
  clickedAt      DateTime? @map("clicked_at") @db.Timestamptz(6)
  clickCount     Int       @default(0) @map("click_count")
  unsubscribedAt DateTime? @map("unsubscribed_at") @db.Timestamptz(6)
  /// 0.18.0 — sự kiện từ SES (qua SNS): đã tới hộp thư, bị trả lại vĩnh viễn, bị báo rác.
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(6)
  bouncedAt      DateTime? @map("bounced_at") @db.Timestamptz(6)
  /// Permanent | Transient | Undetermined (lần trả lại gần nhất)
  bounceType     String?   @map("bounce_type") @db.VarChar(20)
  complainedAt   DateTime? @map("complained_at") @db.Timestamptz(6)
  /// Hoãn gửi tới lúc này (đủ N thư quảng cáo / địa chỉ / 24 giờ — NĐ 91/2020 Điều 13). Vẫn QUEUED.
  deferredUntil  DateTime? @map("deferred_until") @db.Timestamptz(6)
  deferCount     Int       @default(0) @map("defer_count")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  lead     Lead?         @relation(fields: [leadId], references: [id], onDelete: Restrict)
  contact  Contact?      @relation(fields: [contactId], references: [id], onDelete: Restrict)
  events   EmailEvent[]

  @@unique([campaignId, email])
  @@index([tenantId, campaignId, status])
  @@index([tenantId, status, attemptAt])
  @@index([tenantId, email, attemptAt])
  @@index([tenantId, messageId])
  @@map("email_recipients")
}

/// Nhật ký mở / bấm / huỷ nhận tin. Chỉ ghi thêm (trigger chan_sua_xoa).
model EmailEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  campaignId  String   @map("campaign_id") @db.Uuid
  recipientId String   @map("recipient_id") @db.Uuid
  /// open | click | unsubscribe | send | delivery | bounce | complaint | reject | delivery-delay | rendering-failure
  eventType   String   @map("event_type") @db.VarChar(20)
  /// 0.18.0 — chi tiết sự kiện SES đã lọc (loại trả lại, mã chẩn đoán…). Không chứa nội dung thư.
  detail      Json?
  linkIndex   Int?     @map("link_index")
  url         String?  @db.Text
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.Text
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign  EmailCampaign  @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  recipient EmailRecipient @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([tenantId, campaignId, eventType])
  @@map("email_events")
}

/// Danh sách chặn gửi theo địa chỉ email: đã huỷ nhận tin, email hỏng (máy chủ nhận từ chối hẳn).
model EmailSuppression {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  email       String   @db.VarChar(255)
  /// huy-nhan-tin | email-hong | bao-rac (0.18.0 — người nhận bấm "Báo thư rác")
  reason      String   @db.VarChar(30)
  recipientId String?  @map("recipient_id") @db.Uuid
  note        String?  @db.Text
  status      String   @default("hoat-dong") @db.VarChar(30)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("email_suppressions")
}

/// 0.18.0 — Sổ đồng ý nhận thư quảng cáo. **Chỉ ghi thêm** (trigger chặn sửa / xóa, ứng dụng không có
/// quyền UPDATE/DELETE). Trạng thái hiện hành = dòng mới nhất theo (email, mục đích).
model EmailConsent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// Email chuẩn hóa chữ thường.
  email       String   @db.VarChar(255)
  /// quang-cao-email
  purpose     String   @default("quang-cao-email") @db.VarChar(30)
  /// dong-y | rut | phan-doi
  action      String   @db.VarChar(20)
  /// form | landing | webhook | nhap-csv | nhap-tay | huy-nhan-tin | bao-rac | chuyen-doi
  source      String   @db.VarChar(30)
  /// Căn cứ: câu chữ người đó đã tích, biên bản, thư trả lời… Đồng ý bắt buộc có căn cứ.
  evidence    String   @db.Text
  /// Tham chiếu căn cứ: lead_capture:<id>, email_recipient:<id>, csv:<băm tệp>…
  evidenceRef String?  @map("evidence_ref") @db.VarChar(255)
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(6)
  recordedAt  DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  actorId     String?  @map("actor_id") @db.Uuid
  actorEmail  String?  @map("actor_email") @db.VarChar(255)
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  leadId      String?  @map("lead_id") @db.Uuid
  contactId   String?  @map("contact_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email, purpose, occurredAt])
  @@index([tenantId, recordedAt])
  @@map("email_consents")
}

/// 0.18.0 — Thông điệp SNS đã nhận (sự kiện SES). Khóa duy nhất theo MessageId của SNS: gửi lại không xử lý hai lần.
model EmailSnsMessage {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  snsMessageId String   @map("sns_message_id") @db.VarChar(100)
  /// Notification | SubscriptionConfirmation | UnsubscribeConfirmation
  messageType  String   @map("message_type") @db.VarChar(40)
  /// Send | Delivery | Bounce | Complaint | Reject | Rendering Failure | DeliveryDelay | …
  eventType    String?  @map("event_type") @db.VarChar(40)
  sesMessageId String?  @map("ses_message_id") @db.VarChar(255)
  recipientId  String?  @map("recipient_id") @db.Uuid
  /// da-xu-ly | bo-qua | da-xac-nhan
  result       String   @db.VarChar(30)
  note         String?  @db.Text
  receivedAt   DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, snsMessageId])
  @@index([tenantId, receivedAt])
  @@map("email_sns_messages")
}

/// 0.18.0 — Hàng chờ thư giao dịch (không phải quảng cáo): thư xác nhận từ chối (NĐ 91/2020 Điều 20).
/// Khóa chống trùng theo (doanh nghiệp, dedupe_key) — một yêu cầu từ chối chỉ một thư xác nhận.
model EmailTransactional {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  /// xac-nhan-tu-choi
  kind        String    @db.VarChar(30)
  email       String    @db.VarChar(255)
  recipientId String?   @map("recipient_id") @db.Uuid
  dedupeKey   String    @map("dedupe_key") @db.VarChar(150)
  payload     Json      @default("{}")
  /// QUEUED | SENDING | SENT | FAILED
  status      String    @default("QUEUED") @db.VarChar(20)
  attemptAt   DateTime? @map("attempt_at") @db.Timestamptz(6)
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)
  messageId   String?   @map("message_id") @db.VarChar(255)
  reason      String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, createdAt])
  @@map("email_transactionals")
}

/// Mã khôi phục 2 lớp: dùng một lần, chỉ lưu **băm** (HMAC-SHA256 có khóa riêng).
model UserRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.VarChar(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([tenantId, userId])
  @@map("user_recovery_codes")
}
