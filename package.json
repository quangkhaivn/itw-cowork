{
  "name": "cowork-itw",
  "version": "0.15.0",
  "private": true,
  "description": "TGTH Business Cowork — hệ điều hành vận hành doanh nghiệp của Công ty Cổ phần Thế Giới Tin Học.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed/index.ts",
    "db:seed:mau": "tsx --env-file-if-exists=.env prisma/seed/mau.ts",
    "thu:don-vi": "tsx --test thu/don-vi/*.test.ts",
    "thu:cach-ly": "tsx --env-file-if-exists=.env thu/thu-cach-ly-tenant.ts",
    "thu:phan-quyen": "tsx --env-file-if-exists=.env thu/thu-phan-quyen.ts",
    "thu:su-kien": "tsx --env-file-if-exists=.env thu/thu-su-kien.ts",
    "thu:quan-tri": "tsx --env-file-if-exists=.env thu/thu-quan-tri.ts",
    "thu:http": "tsx --env-file-if-exists=.env thu/thu-http.ts",
    "thu:tich-hop": "npm run thu:cach-ly && npm run thu:phan-quyen && npm run thu:su-kien && npm run thu:quan-tri && npm run thu:crm && npm run thu:san-pham && npm run thu:bao-gia && npm run thu:don-hang && npm run thu:dich-vu && npm run thu:tai-chinh && npm run thu:tu-dong-hoa && npm run thu:tro-ly && npm run thu:mua-hang && npm run thu:cong-no-tra && npm run thu:tra-hang && npm run thu:chuyen-kho && npm run thu:dinh-kem && npm run thu:khach-nang-cao && npm run thu:qa-khach && npm run thu:marketing && npm run thu:qa-marketing && npm run thu:gop-k-m && npm run thu:email && npm run thu:xac-thuc-2-lop && npm run thu:qa-email && npm run thu:gop-m-e",
    "thu:tat-ca": "npm run thu:don-vi && npm run thu:tich-hop",
    "kiem-tra": "npm run typecheck && npm run lint && npm run thu:don-vi && npm run build",
    "thu:crm": "tsx --env-file-if-exists=.env thu/thu-crm.ts",
    "thu:san-pham": "tsx --env-file-if-exists=.env thu/thu-san-pham.ts",
    "thu:bao-gia": "tsx --env-file-if-exists=.env thu/thu-bao-gia.ts",
    "thu:don-hang": "tsx --env-file-if-exists=.env thu/thu-don-hang.ts",
    "thu:dich-vu": "tsx --env-file-if-exists=.env thu/thu-dich-vu.ts",
    "thu:tai-chinh": "tsx --env-file-if-exists=.env thu/thu-tai-chinh.ts",
    "thu:tu-dong-hoa": "tsx --env-file-if-exists=.env thu/thu-tu-dong-hoa.ts",
    "thu:tro-ly": "tsx --env-file-if-exists=.env thu/thu-tro-ly.ts",
    "thu:mua-hang": "tsx --env-file-if-exists=.env thu/thu-mua-hang.ts",
    "thu:cong-no-tra": "tsx --env-file-if-exists=.env thu/thu-cong-no-tra.ts",
    "thu:tra-hang": "tsx --env-file-if-exists=.env thu/thu-tra-hang.ts",
    "thu:chuyen-kho": "tsx --env-file-if-exists=.env thu/thu-chuyen-kho.ts",
    "thu:dinh-kem": "tsx --env-file-if-exists=.env thu/thu-dinh-kem.ts",
    "thu:khach-nang-cao": "tsx --env-file-if-exists=.env thu/thu-khach-nang-cao.ts",
    "thu:qa-khach": "tsx --env-file-if-exists=.env thu/thu-qa-khach.ts",
    "thu:marketing": "tsx --env-file-if-exists=.env thu/thu-marketing.ts",
    "thu:qa-marketing": "tsx --env-file-if-exists=.env thu/thu-qa-marketing.ts",
    "thu:qa-marketing-http": "tsx --env-file-if-exists=.env thu/thu-qa-marketing-http.ts",
    "thu:gop-k-m": "tsx --env-file-if-exists=.env thu/thu-gop-k-m.ts",
    "thu:email": "tsx --env-file-if-exists=.env thu/thu-email.ts",
    "thu:xac-thuc-2-lop": "tsx --env-file-if-exists=.env thu/thu-xac-thuc-2-lop.ts",
    "thu:qa-email": "tsx --env-file-if-exists=.env thu/thu-qa-email.ts",
    "thu:gop-m-e": "tsx --env-file-if-exists=.env thu/thu-gop-m-e.ts",
    "thu:qa-email-http": "tsx --env-file-if-exists=.env thu/thu-qa-email-http.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "ioredis": "^5.4.1",
    "jose": "^6.0.11",
    "next": "16.3.1",
    "nodemailer": "10.0.10",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.4.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "prisma": "^7.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
